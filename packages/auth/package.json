{
  "name": "@openmeld/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Authentication package with runtime libraries, Cloudflare email integration, and ORM support",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./organization-policy": {
      "types": "./dist/organization-policy.d.ts",
      "default": "./dist/organization-policy.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown --no-clean",
    "test": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest run",
    "test:watch": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./",
    "email:dev": "email dev --port 3333 --dir src/templates",
    "email:export": "email export --dir src/templates"
  },
  "dependencies": {
    "@better-auth/electron": "1.6.30",
    "@better-auth/passkey": "1.6.30",
    "@better-auth/utils": "0.4.2",
    "@openmeld/db": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@react-email/body": "0.2.1",
    "@react-email/button": "0.2.1",
    "@react-email/container": "0.0.16",
    "@react-email/head": "0.0.13",
    "@react-email/heading": "0.0.16",
    "@react-email/hr": "0.0.12",
    "@react-email/html": "0.0.12",
    "@react-email/preview": "0.0.14",
    "@react-email/render": "2.0.4",
    "@react-email/section": "0.0.17",
    "@react-email/text": "0.1.6",
    "better-auth": "1.6.30",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.1",
    "validator": "13.15.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@react-email/ui": "6.11.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/validator": "13.15.10",
    "oxc-resolver": "^11.0.0",
    "react-email": "6.11.3",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
