{
  "name": "@openmeld/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Authentication package with runtime libraries, Cloudflare email integration, and ORM support",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./organization-policy": {
      "types": "./dist/organization-policy.d.ts",
      "default": "./dist/organization-policy.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./",
    "email:dev": "email dev --port 3333 --dir src/templates",
    "email:export": "email export --dir src/templates"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.30",
    "@better-auth/utils": "0.4.2",
    "@openmeld/db": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@react-email/components": "^1.0.7",
    "better-auth": "1.6.30",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.4",
    "validator": "13.15.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@react-email/preview-server": "5.2.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/validator": "13.15.10",
    "oxc-resolver": "^11.0.0",
    "react-email": "5.2.9",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "~3.2.0"
  }
}
