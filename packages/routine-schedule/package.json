{
  "name": "@openmeld/routine-schedule",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenMeld - Shared Center Agent Routine schedule semantics",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxc-resolver": "^11.0.0",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
