{
  "name": "@openmeld/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenMeld - Shared UI primitives",
  "license": "MIT",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#fluid/*": "./src/fluid/*.tsx",
    "#hooks/use-merge-split": "./src/hooks/use-merge-split.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/shape-context": "./src/lib/shape-context.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./fluid/*": "./src/fluid/*.tsx",
    "./hooks/use-merge-split": "./src/hooks/use-merge-split.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/shape-context": "./src/lib/shape-context.tsx",
    "./lib/surface-context": "./src/lib/surface-context.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./",
    "test": "vitest run --environment jsdom"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@lobehub/icons": "5.22.0",
    "@openmeld/schemas": "workspace:*",
    "@outpacelabs/avatars": "0.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.4",
    "border-beam": "1.4.1",
    "bot-avatars": "0.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "framer-motion": "^12.35.2",
    "media-chrome": "4.19.2",
    "motion": "^12.38.0",
    "react-day-picker": "^10.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
