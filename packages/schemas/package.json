{
  "name": "@openmeld/schemas",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "OpenMeld - Shared Zod schemas and inferred types",
  "imports": {
    "#local-components": "./src/schemas/local-components.ts",
    "#lazy-zod": "./src/lazy-zod.ts",
    "#windows-artifact": "./src/windows-artifact.ts"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown --no-clean && node ./scripts/verify-build-output.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxc-resolver": "^11.0.0",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
