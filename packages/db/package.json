{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@openmeld/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenMeld - DB tooling, facts, registries, and diagnostics helpers",
  "license": "MIT",
  "exports": {
    "./postgresql": {
      "types": "./dist/postgresql.d.mts",
      "default": "./dist/postgresql.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./auth": {
      "types": "./dist/auth.d.mts",
      "default": "./dist/auth.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./core/facts": {
      "types": "./dist/core-facts.d.mts",
      "default": "./dist/core-facts.mjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.mts",
      "default": "./dist/diagnostics.mjs"
    },
    "./facts": {
      "types": "./dist/facts.d.mts",
      "default": "./dist/facts.mjs"
    },
    "./query": {
      "types": "./dist/query.d.mts",
      "default": "./dist/query.mjs"
    },
    "./tooling": {
      "types": "./dist/tooling.d.mts",
      "default": "./dist/tooling.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown --no-clean",
    "db:check": "pnpm exec drizzle-kit check --config postgresql/drizzle.config.ts",
    "db:inspect:dev": "node ../../tooling/postgresql/cli.mjs inspect local",
    "db:generate": "pnpm exec drizzle-kit generate --config postgresql/drizzle.config.ts",
    "db:migrate:dev": "node ../../tooling/postgresql/cli.mjs migrate local",
    "db:migrate:prod": "node ../../tooling/postgresql/cli.mjs migrate production",
    "db:verify:dev": "node ../../tooling/postgresql/cli.mjs accept local",
    "db:verify:prod": "node ../../tooling/postgresql/cli.mjs accept production",
    "db:optimize:dev": "node ../../tooling/postgresql/cli.mjs optimize local",
    "db:optimize:prod": "node ../../tooling/postgresql/cli.mjs optimize production",
    "auth:generate": "node --experimental-strip-types ./scripts/auth-generate.ts",
    "db:studio": "pnpm exec drizzle-kit studio --config postgresql/drizzle.config.ts",
    "test": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest run",
    "test:watch": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "fix": "biome check --write --no-errors-on-unmatched ./"
  },
  "dependencies": {
    "@openmeld/schemas": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "8.15.6",
    "@typescript/typescript6": "6.0.2",
    "drizzle-kit": "^0.31.9",
    "oxc-resolver": "^11.0.0",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11",
    "wrangler": "catalog:"
  }
}
