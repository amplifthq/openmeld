{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": ["!!**/.claude/worktrees"]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "fix": "safe",
          "options": {
            "style": "type"
          }
        },
        "useTemplate": {
          "level": "error",
          "fix": "safe"
        },
        "useReadonlyClassProperties": {
          "level": "error",
          "fix": "safe"
        }
      },
      "complexity": {
        "useOptionalChain": {
          "level": "error",
          "fix": "safe"
        }
      },
      "suspicious": {
        "useStaticResponseMethods": {
          "level": "error",
          "fix": "safe"
        }
      },
      "performance": {
        "noDelete": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "overrides": [
    {
      // Vendored Plate registry UI (platejs.org/r, v53). Kept close to
      // upstream so future registry updates stay diffable; upstream style
      // and a11y patterns are accepted here and only here.
      "includes": ["**/components/editor/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useAriaPropsSupportedByRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useKeyWithMouseEvents": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off",
            "noVoid": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
