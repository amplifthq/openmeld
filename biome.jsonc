{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!changelog/index.json",
      "!!**/.claude/worktrees",
      "!!**/remote-agent/transport/lark/protocol"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "fix": "safe",
          "options": {
            "style": "type"
          }
        },
        "useTemplate": {
          "level": "error",
          "fix": "safe"
        },
        "useReadonlyClassProperties": {
          "level": "error",
          "fix": "safe"
        }
      },
      "complexity": {
        "useOptionalChain": {
          "level": "error",
          "fix": "safe"
        }
      },
      "suspicious": {
        "useStaticResponseMethods": {
          "level": "error",
          "fix": "safe"
        }
      },
      "performance": {
        "noDelete": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "overrides": [
    {
      // Registry-owned Evil Charts source retains upstream structure for reviewable updates.
      // Local product composition and data contracts retain normal linting.
      "includes": ["packages/ui/src/components/evilcharts/**"],
      "linter": { "enabled": false }
    },
    {
      // Flue agent hooks are not React hooks: resource hooks may be composed
      // conditionally and in loops under Flue's per-render resource contract.
      "includes": [
        "services/remote-agent/.flue/agents/**",
        "services/remote-agent/tests/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": { "useHookAtTopLevel": "off" }
        }
      }
    },
    {
      // These Worker entrypoints use Zod's namespace import so esbuild can
      // remove unused locale modules from the production bundle.
      "includes": [
        "services/gateway/src/lib/openconnector-client.ts",
        "services/gateway/src/lib/slack-oauth-client.ts",
        "services/gateway/src/routes/rpc-http.permission-mode-suggestions.ts",
        "services/remote-agent/agent-core/center-agent-session-title.ts",
        "services/remote-agent/agent-core/image-understanding.ts",
        "services/remote-agent/agent-core/tools.ts",
        "services/remote-agent/flue-adapter/model.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      // Vendored Plate registry UI (platejs.org/r, v53). Kept close to
      // upstream so future registry updates stay diffable; upstream style
      // and a11y patterns are accepted here and only here.
      "includes": ["**/components/editor/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useAriaPropsSupportedByRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useKeyWithMouseEvents": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off",
            "noVoid": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
