      return { applied: 0, skipped: [] };\n        }\n        return this.#runWithReconnect(resolvedId, \"pull\", async (handle) => {\n          if (expectedRuntimeId !== undefined) {\n            assertExecutionRuntime(\"post-command sync\", expectedRuntimeId, handle.runtimeId);\n          }\n          if (handle.sync === \"none\") return { applied: 0, skipped: [] };\n          const executionKey =\n            executionId === undefined\n              ? undefined\n              : this.#executionRuntimeKey(resolvedId, executionId);\n          const prior =\n            executionKey && handle.runtimeId\n              ? this.#executionRuntimes.syncOutcome(executionKey, handle.runtimeId)\n              : undefined;\n          if (prior?.error)\n            throw new Error(`${prior.error}: execution file source is no longer available`);\n          if (prior)\n            return { applied: 0, skipped: prior.skipped, skippedTruncated: prior.skippedTruncated };\n          const horizon = await this.#executionSyncTarget(resolvedId, handle, executionId);\n          const step = await pullBlocks(this.#db, handle.rpc.sync, { backend: resolvedId })\n            [Symbol.asyncIterator]()\n            .next();\n          if (step.done) throw new Error(\"sync: missing pull progress\");\n          if (\n            !step.value.complete ||\n            compareChangeCursors(readFetchCursor(this.#db, resolvedId), horizon) < 0\n          )\n            throw new WorkspaceSyncPendingError({ ...step.value, complete: false });\n          if (executionKey && handle.runtimeId) {\n            const window = this.#executionRuntimes.syncWindow(executionKey, handle.runtimeId);\n            if (!window)\n              throw new Error(\n                \"ESYNC_SCOPE_UNKNOWN: execution synchronization start is unavailable\",\n              );\n            const outcome = this.#freezeExecutionSync(\n              resolvedId,\n              executionKey,\n              handle.runtimeId,\n            