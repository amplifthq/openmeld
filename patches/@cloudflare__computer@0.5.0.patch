peration.generation,\n      backend,\n      direction: \"push\",\n      mode: operation.mode ?? \"entries\",\n      cursor: after,\n      targetCursor: target,\n      entries: 0,\n      bytes: 0,\n      skipped: 0,\n      phase: \"cleaning\",\n      complete,\n    };\n  }\n\n  const effectiveProfile =\n    operation.blockAfter !== undefined && compareChangeCursors(operation.blockAfter, after) === 0\n      ? (shrinkBlockProfile(db, backend, \"push\", operation.generation, now()) ?? profile)\n      : profile;\n\n  timing?.stage(\"retentionMs\");\n  const scope = await retainTransfer(db, remote, backend, \"push\", operation.generation);\n  timing?.stage(\"prepareMs\");\n  const preparation = prepareChangePlan(db, {\n    generation: operation.generation,\n    after,\n    through: target,\n    ...(options.ignore === undefined ? {} : { ignore: options.ignore }),\n  });\n  if (timing) timing.data.preparationReads = preparation.reads;\n  timing?.stage(\"localMs\");\n  if (!preparation.ready)\n    return {\n      operationId: operation.generation,\n      generation: operation.generation,\n      backend,\n      direction: \"push\",\n      mode: operation.mode ?? \"entries\",\n      phase: \"preparing\",\n      checkpoint: preparation.checkpoint,\n      cursor: after,\n      targetCursor: target,\n      entries: 0,\n      bytes: 0,\n      skipped: 0,\n      complete: false,\n    };\n  markBlockStarted(db, backend, \"push\", operation.generation, after, now());\n\n  // Plan the block locally. planBlock owns the ordered-prefix and\n  // byte-bound rules, so push and pull select blocks identically.\n  timing?.stage(\"planMs\");\n  const planned = await planBlock(db, {\n    assertActive: () => {\n      assertActiveOperation(db, backend, \"push\", operation.generation);\n    },\n    generation: operation.generation,\n    after,\n    through: target,\n    profile: effectiveProfile,\n    ...(options.ignore === undefined ? {} : { ignore: options.ignore }),\n  });\n  if (timing) {\n   