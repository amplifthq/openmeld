--- /dev/null
+++ b/dist/working-context.mjs
@@ -0,0 +1,26 @@
+// Keep the native compactor's image heuristic in one place. This is an
+// economic projection, not vendor tokenization or physical image admission.
+export const COMPACTION_IMAGE_TOKENS = 1200;
+
+export function measureWorkingContext(input) {
+  let imageTokens = 0;
+  const messages = input.messages.map((message) => {
+    const { role, content, toolCallId, toolName, isError } = message;
+    const visible = { role, content, toolCallId, toolName, isError };
+    if (!Array.isArray(content)) return visible;
+    return {
+      ...visible,
+      content: content.map((block) => {
+        if (block.type !== "image") return block;
+        imageTokens += COMPACTION_IMAGE_TOKENS;
+        return { type: "image", mimeType: block.mimeType };
+      })
+    };
+  });
+  return Math.ceil(new TextEncoder().encode(JSON.stringify({ ...input, messages })).byteLength / 4) + imageTokens;
+}
+
+export function workingContextBudget(input, limit, headroom = 0) {
+  const fixedTokens = measureWorkingContext({ ...input, messages: [] });
+  return { limitTokens: limit, targetTokens: limit - headroom, fixedTokens };
+}
