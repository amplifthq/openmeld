    "@platejs/slash-command": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.11",
