{
  "name": "openmeld-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node ./scripts/dev-runtime-preflight.mjs && vite dev --port 3000",
    "dev:isolated": "node ./scripts/dev-runtime-preflight.mjs && vite dev",
    "dev:prod": "CLOUDFLARE_ENV=prod vite dev --port 3434",
    "build": "vite build",
    "build:prod": "pnpm -C ../.. exec turbo run build --filter=openmeld-web^... && CLOUDFLARE_ENV=prod vite build",
    "build:stg": "pnpm -C ../.. exec turbo run build --filter=openmeld-web^... && VITE_OPENMELD_SETUP_USER_FACING_COMMAND=openmeld-canary CLOUDFLARE_ENV=stg vite build",
    "favicon:generate": "node ./scripts/generate-favicon.mjs",
    "cf-typegen": "wrangler types --env-interface=CloudflareBindings && pnpm run typecheck",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:full": "pnpm run test && pnpm run test:integration",
    "deploy": "pnpm run build:prod && dotenv -e ../../.env -o -- wrangler deploy --env=prod",
    "deploy:stg": "pnpm run build:stg && wrangler deploy --env=stg",
    "sync:config:prod": "pnpm run deploy",
    "sync:config:stg": "pnpm run deploy:stg",
    "sync:secrets:prod": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env prod --file .dev.vars.prod WEB_OPENMELD_SPACE_ACCESS_COOKIE_SECRET",
    "sync:secrets:stg": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env stg --from-env WEB_OPENMELD_SPACE_ACCESS_COOKIE_SECRET",
    "sync:prod": "pnpm run sync:secrets:prod && pnpm run sync:config:prod",
    "sync:stg": "pnpm run sync:secrets:stg && pnpm run sync:config:stg",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.34",
    "@base-ui/react": "^1.2.0",
    "@cloudflare/vite-plugin": "1.54.6",
    "@dagrejs/dagre": "^3.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons": "5.0.1",
    "@openmeld/agent-profile": "workspace:*",
    "@openmeld/agent-runtime": "workspace:*",
    "@openmeld/api-client": "workspace:*",
    "@openmeld/auth": "workspace:*",
    "@openmeld/gateway-contract": "workspace:*",
    "@openmeld/projects": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/routine-schedule": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/space": "workspace:*",
    "@openmeld/space-mesh": "workspace:*",
    "@openmeld/start": "workspace:*",
    "@openmeld/ui": "workspace:*",
    "@openmeld/utils": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@platejs/basic-nodes": "^53.0.0",
