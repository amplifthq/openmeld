{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmeld-web",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": {
    "mode": "smart"
  },
  "dev": {
    "ip": "localhost",
    "port": 3000,
    "inspector_port": 9232
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "OPENMELD_OBSERVABILITY",
      "dataset": "openmeld_runtime_evidence"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OPENMELD_DESKTOP_DOWNLOADS",
      "bucket_name": "openmeld-desktop-downloads-prod"
    }
  ],
  "ratelimits": [
    {
      "name": "OPENMELD_CLI_DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["WEB_OPENMELD_SPACE_ACCESS_COOKIE_SECRET"]
  },
  "vars": {
    "OPENMELD_WORKER_ENVIRONMENT": "local",
    "OPENMELD_GATEWAY_URL": "http://localhost:8080",
    "WEB_APP_URL": "http://localhost:3000",
    "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
    "BETTER_AUTH_URL": "http://localhost:8788",
    "VITE_BETTER_AUTH_URL": "http://localhost:8788",
    "VITE_APP_TITLE": "OpenMeld Web"
  },
  "env": {
    "stg": {
      "ratelimits": [
        {
          "name": "OPENMELD_CLI_DOWNLOAD_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 600, "period": 60 }
        }
      ],
      "route": {
        "custom_domain": true,
        "pattern": "app.staging.openmeld.ai"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_stg"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OPENMELD_DESKTOP_DOWNLOADS",
          "bucket_name": "openmeld-desktop-downloads-stg"
        }
      ],
      "secrets": {
        "required": ["WEB_OPENMELD_SPACE_ACCESS_COOKIE_SECRET"]
      },
      // Gateway proxy transport. Local development has no binding and keeps
      // the public fetch to OPENMELD_GATEWAY_URL.
      "services": [
        {
          "binding": "OPENMELD_GATEWAY_WORKER",
          "service": "openmeld-gateway-stg"
        }
      ],
      "vars": {
        "OPENMELD_WORKER_ENVIRONMENT": "stg",
        "OPENMELD_GATEWAY_URL": "https://gateway.staging.openmeld.ai",
        "WEB_APP_URL": "https://app.staging.openmeld.ai",
        "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
        "BETTER_AUTH_URL": "https://auth.staging.openmeld.ai",
        "VITE_BETTER_AUTH_URL": "https://auth.staging.openmeld.ai",
        "VITE_APP_TITLE": "OpenMeld Staging",
        "VITE_OPENMELD_SETUP_USER_FACING_COMMAND": "openmeld-canary"
      }
    },
    "prod": {
      "ratelimits": [
        {
          "name": "OPENMELD_CLI_DOWNLOAD_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 600, "period": 60 }
        }
      ],
      "route": {
        "custom_domain": true,
        "pattern": "app.openmeld.ai"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_prod"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OPENMELD_DESKTOP_DOWNLOADS",
          "bucket_name": "openmeld-desktop-downloads-prod"
        }
      ],
      "secrets": {
        "required": ["WEB_OPENMELD_SPACE_ACCESS_COOKIE_SECRET"]
      },
      // Gateway proxy transport. Local development has no binding and keeps
      // the public fetch to OPENMELD_GATEWAY_URL.
      "services": [
        {
          "binding": "OPENMELD_GATEWAY_WORKER",
          "service": "openmeld-gateway-prod"
        }
      ],
      "vars": {
        "OPENMELD_WORKER_ENVIRONMENT": "prod",
        "OPENMELD_DESKTOP_DOWNLOAD_ORIGIN": "https://downloads.openmeld.ai",
        "OPENMELD_GATEWAY_URL": "https://gateway.openmeld.ai",
        "WEB_APP_URL": "https://app.openmeld.ai",
        "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
        "BETTER_AUTH_URL": "https://auth.openmeld.ai",
        "VITE_BETTER_AUTH_URL": "https://auth.openmeld.ai",
        "VITE_APP_TITLE": "OpenMeld Web"
      }
    }
  }
}
