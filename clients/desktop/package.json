{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@openmeld/desktop",
  "productName": "OpenMeld Desktop",
  "version": "0.1.0-preview.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "OpenMeld Desktop GUI (Electron) — thin local control surface for the OpenMeld Service. See developing/clients/desktop.md.",
  "scripts": {
    "build:contract-deps": "pnpm -C ../.. --filter @openmeld/agent-runtime... build",
    "dev": "electron-vite dev",
    "build": "pnpm run build:contract-deps && electron-vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "package:mac:arm64:unsigned": "pnpm run icons:generate && pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never",
    "start": "electron-vite preview",
    "pretypecheck": "pnpm run build:contract-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:contract-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "pnpm run build:contract-deps",
    "check": "biome check --no-errors-on-unmatched ./ && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openmeld/agent-runtime": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "build": {
    "appId": "sh.openmeld.desktop",
    "productName": "OpenMeld Desktop",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "out/**/*",
      "resources/icon.icns",
      "resources/icon.png",
      "resources/tray-icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "OpenMeld-Desktop-${version}-macos-${arch}-unsigned.${ext}",
      "sign": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^27.0.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vitest": "~3.2.0"
  }
}
