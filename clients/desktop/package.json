{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@openmeld/desktop",
  "productName": "OpenMeld Dev",
  "version": "0.1.41",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "OpenMeld Desktop GUI (Electron) — thin local control surface for the OpenMeld Service. See developing/clients/desktop.md.",
  "scripts": {
    "build:contract-deps": "pnpm -C ../.. exec turbo run build --filter=@openmeld/adapter-core --filter=@openmeld/api-client --filter=@openmeld/agent-runtime --filter=@openmeld/gateway-contract --filter=@openmeld/protocol --filter=@openmeld/start --concurrency=1",
    "dev": "electron-vite dev",
    "build": "pnpm run build:contract-deps && electron-vite build && node scripts/check-runtime-deps.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "package:mac:arm64:unsigned": "pnpm run icons:generate && pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never",
    "start": "electron-vite preview",
    "pretypecheck": "pnpm run build:contract-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:contract-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "pnpm run build:contract-deps",
    "check": "biome check --no-errors-on-unmatched ./ && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/electron": "1.6.30",
    "@better-auth/utils": "0.4.2",
    "@openmeld/agent-runtime": "workspace:*",
    "@openmeld/api-client": "workspace:*",
    "@openmeld/gateway-contract": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/start": "workspace:*",
    "@openmeld/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.6.30",
    "builder-util-runtime": "9.7.0",
    "conf": "15.0.2",
    "electron-updater": "6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "7.7.4",
    "undici": "7.30.1",
    "ws": "^8.18.3",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "build": {
    "afterPack": "../../scripts/desktop/verify-archive.mjs",
    "forceCodeSigning": true,
    "appId": "sh.openmeld.desktop.dev",
    "productName": "OpenMeld Dev",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "!**/.turbo{,/**}",
      "out/**/*",
      "resources/icon.icns",
      "resources/icon.png",
      "resources/tray-icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleName": "OpenMeld Dev",
        "CFBundleDisplayName": "OpenMeld Dev"
      },
      "icon": "resources/icon.icns",
      "identity": "-",
      "notarize": false,
      "strictVerify": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "OpenMeld-Desktop-${version}-macos-${arch}-unsigned.${ext}",
      "sign": false
    }
  },
  "devDependencies": {
    "@openmeld/adapter-core": "workspace:*",
    "@openmeld/local-service": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^27.0.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
