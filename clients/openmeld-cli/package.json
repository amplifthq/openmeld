{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "openmeld",
  "version": "0.3.269",
  "openMeldReleaseDate": "2026-10-16",
  "description": "OpenMeld CLI - https://openmeld.ai",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openmeld": "dist/openmeld.js"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "22.x || 24.x || 25.x"
  },
  "files": [
    "README.md",
    "dist",
    "!dist/binary/**",
    "skills"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-macos-keychain-addon.mjs --copy-npm && node scripts/copy-windows-process-helper.mjs",
    "prepack": "pnpm -C ../.. run verify:release-ready -- --force",
    "deploy": "pnpm -C ../.. run deploy -- --scope cli",
    "prepublishOnly": "node -e \"throw new Error('Publish the verified tarball through the root pnpm run deploy -- --scope cli entrypoint, not this source directory.')\"",
    "verify:npm-artifact": "node ../../scripts/release/npm-cli-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:full": "pnpm run test && pnpm run test:integration",
    "test:local-service": "vitest run --config vitest.integration.config.ts tests/local-service-state.integration.test.ts tests/local-service-command.integration.test.ts tests/local-service-menu.integration.test.ts tests/local-service-run.integration.test.ts tests/local-service-bootstrap-recommendation.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@anthropic-ai/sdk": "^0.131.0",
    "@clack/prompts": "^1.0.1",
    "@mariozechner/pi-tui": "0.57.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "^1.18.34",
    "@opencode/client": "2.0.24",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.1.0",
    "wrap-ansi": "10.0.0",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openmeld/adapter-antigravity": "workspace:*",
    "@openmeld/adapter-claude-code": "workspace:*",
    "@openmeld/adapter-codex": "workspace:*",
    "@openmeld/adapter-core": "workspace:*",
    "@openmeld/adapter-cursor": "workspace:*",
    "@openmeld/adapter-grok-bot": "workspace:*",
    "@openmeld/adapter-grok-build": "workspace:*",
    "@openmeld/adapter-openclaw": "workspace:*",
    "@openmeld/adapter-opencode": "workspace:*",
    "@openmeld/agent-runtime": "workspace:*",
    "@openmeld/api-client": "workspace:*",
    "@openmeld/gateway-contract": "workspace:*",
    "@openmeld/local-execution": "workspace:*",
    "@openmeld/local-service": "workspace:*",
    "@openmeld/projects": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/routine-schedule": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/space": "workspace:*",
    "@openmeld/space-mesh": "workspace:*",
    "@openmeld/start": "workspace:*",
    "@openmeld/utils": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "node-gyp": "^12.4.0",
    "oxc-resolver": "^11.0.0",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-lightningcss": "^0.4.0",
    "vitest": "4.1.11"
  },
  "openmeld": {
    "releaseLine": "openmeld-greenfield-2026-07",
    "minRequiredCliVersion": "0.3.251"
  }
}
