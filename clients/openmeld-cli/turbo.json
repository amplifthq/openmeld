{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/config/agents/registry.json"
      ]
    },
    "test:daemon": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
