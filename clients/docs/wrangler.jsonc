{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmeld-docs",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/docs", "/docs/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "OPENMELD_WORKER_ENVIRONMENT": "local"
  },
  "env": {
    "stg": {
      "name": "openmeld-docs-stg",
      "route": {
        "pattern": "docs.staging.openmeld.ai",
        "custom_domain": true
      },
      "vars": {
        "OPENMELD_WORKER_ENVIRONMENT": "stg"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_stg"
        }
      ]
    },
    "prod": {
      "name": "openmeld-docs-prod",
      "route": {
        "pattern": "docs.openmeld.ai",
        "custom_domain": true
      },
      "vars": {
        "OPENMELD_WORKER_ENVIRONMENT": "prod"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_prod"
        }
      ]
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "OPENMELD_OBSERVABILITY",
      "dataset": "openmeld_runtime_evidence"
    }
  ]
}
