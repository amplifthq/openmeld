{
  "name": "openmeld-docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3600",
    "build": "vite build",
    "build:prod": "CLOUDFLARE_ENV=prod vite build",
    "build:stg": "CLOUDFLARE_ENV=stg vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3600",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run check:content && pnpm run typecheck",
    "cf-typegen": "wrangler types --env-interface=CloudflareBindings && pnpm run typecheck",
    "deploy": "node ../../scripts/release/production-artifact-check.mjs --scope docs && wrangler deploy --env=prod",
    "deploy:stg": "pnpm run build:stg && wrangler deploy --env=stg",
    "sync:config:prod": "pnpm run deploy",
    "sync:config:stg": "pnpm run deploy:stg",
    "sync:prod": "pnpm run sync:config:prod",
    "sync:stg": "pnpm run sync:config:stg"
  },
  "dependencies": {
    "@openmeld/ui": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "catalog:"
  }
}
