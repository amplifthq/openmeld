{
  "name": "openmeld-website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3500",
    "build": "vite build",
    "build:prod": "CLOUDFLARE_ENV=prod vite build",
    "build:stg": "CLOUDFLARE_ENV=stg vite build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface=CloudflareBindings && pnpm run typecheck",
    "deploy": "node ../../scripts/release/production-artifact-check.mjs --scope website && wrangler deploy --env=prod",
    "deploy:stg": "pnpm run build:stg && wrangler deploy --env=stg",
    "sync:config:prod": "pnpm run deploy",
    "sync:config:stg": "pnpm run deploy:stg",
    "sync:prod": "pnpm run sync:config:prod",
    "sync:stg": "pnpm run sync:config:stg"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@openmeld/api-client": "workspace:*",
    "@openmeld/product-catalog": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "metal-fx": "^2.0.11",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-sanitize": "6.0.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^27.0.0",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~3.2.0",
    "wrangler": "catalog:"
  }
}
