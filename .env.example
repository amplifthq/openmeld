# Root `.env` is only used by `auth/package.json` -> `auth:generate`
# (Better Auth schema generation in Node tooling mode).
# It is not used by Worker runtime (`wrangler dev/deploy`).
#
# Generate with:
# openssl rand -base64 32
BETTER_AUTH_OPENMELD_SECRET=

CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_ID=

SLACK_APP_CONFIG_ACCESS_TOKEN=

SLACK_APP_CONFIG_REFRESH_TOKEN=