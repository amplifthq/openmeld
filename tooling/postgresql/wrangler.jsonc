{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openmeld-postgresql-probe-stg",
  "main": "worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "e74a33891b4c7a16b1fe853c41011f52",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OPENMELD_WORKER_ENVIRONMENT": "postgresql-foundation-staging",
    "POSTGRESQL_PROBE_EXPIRES_AT": "2026-10-04T00:00:00Z"
  },
  "secrets": {
    "required": ["POSTGRESQL_OPENMELD_PROBE_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "OPENMELD_POSTGRESQL",
      "id": "6af2d43ec8d8498b9607c653ca231e73"
    }
  ]
}
