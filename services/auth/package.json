{
  "name": "@openmeld/auth-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenMeld - Auth Worker",
  "license": "MIT",
  "scripts": {
    "predev": "node ../../scripts/dev/run-guarded-service-predev.mjs auth-worker \"pnpm -C ../.. exec turbo run build --filter=@openmeld/auth-worker && pnpm run db:migrate:dev && pnpm run db:verify:dev\"",
    "dev": "wrangler dev -c ./wrangler.jsonc -c ../core/wrangler.jsonc --persist-to ../../.wrangler-dev-state --inspector-port 19330",
    "predev:isolated": "node ../../scripts/dev/run-guarded-service-predev.mjs auth-worker \"pnpm -C ../.. exec turbo run build --filter=@openmeld/auth-worker\"",
    "dev:isolated": "node ../../scripts/dev/run-isolated-worker-dev.mjs auth",
    "dev:prod": "wrangler dev --env prod --persist-to ../../.wrangler-dev-state --inspector-port 19330",
    "build:workspace-dependencies": "pnpm -C ../.. exec turbo run build --filter=@openmeld/auth-worker^...",
    "build:lazy-runtime-modules": "node scripts/build-lazy-runtime-modules.mjs",
    "deploy": "pnpm run build:workspace-dependencies && dotenv -e ../../.env -o -- wrangler deploy --minify --env=prod",
    "deploy:stg": "pnpm run build:workspace-dependencies && wrangler deploy --minify --env=stg",
    "sync:config:prod": "pnpm run deploy",
    "sync:config:stg": "pnpm run deploy:stg",
    "sync:secrets:prod": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env prod --file .dev.vars.prod BETTER_AUTH_OPENMELD_SECRET GITHUB_OPENMELD_AUTH_OAUTH_CLIENT_SECRET GOOGLE_OPENMELD_AUTH_OAUTH_CLIENT_SECRET",
    "sync:secrets:stg": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env stg --from-env BETTER_AUTH_OPENMELD_SECRET",
    "sync:prod": "pnpm run sync:secrets:prod && pnpm run sync:config:prod",
    "sync:stg": "pnpm run sync:secrets:stg && pnpm run sync:config:stg",
    "test": "pnpm run test:unit",
    "test:full": "pnpm run test && pnpm run test:runtime",
    "test:unit": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest run",
    "test:runtime": "node ../../tooling/postgresql/local.mjs run node ./tests/auth-worker-runtime-smoke.mjs",
    "test:watch": "node ../../tooling/postgresql/local.mjs run pnpm exec vitest",
    "typecheck": "pnpm run typecheck:worker && pnpm run typecheck:tooling",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.node-tooling.json --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "cf-typegen": "wrangler types --env-interface=CloudflareBindings && pnpm run typecheck",
    "auth:generate": "pnpm -C ../.. exec turbo run auth:generate --filter=@openmeld/db",
    "db:generate": "pnpm -C ../.. db:generate",
    "db:check": "pnpm -C ../.. db:check",
    "db:migrate:dev": "pnpm -C ../.. db:migrate:dev",
    "db:migrate:prod": "pnpm -C ../.. db:migrate:prod",
    "db:verify:dev": "pnpm -C ../.. db:verify:dev",
    "db:verify:prod": "pnpm -C ../.. db:verify:prod",
    "db:optimize:dev": "pnpm -C ../.. db:optimize:dev",
    "db:optimize:prod": "pnpm -C ../.. db:optimize:prod",
    "db:optimize": "pnpm run db:optimize:dev && pnpm run db:optimize:prod",
    "db:studio": "pnpm -C ../.. db:studio"
  },
  "dependencies": {
    "@better-auth/core": "1.6.30",
    "@better-auth/utils": "0.4.2",
    "@openmeld/auth": "workspace:*",
    "@openmeld/db": "workspace:*",
    "@openmeld/gateway-contract": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "better-auth": "1.6.30",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "better-sqlite3": "^12.6.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "esbuild": "0.28.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11",
    "wrangler": "catalog:"
  }
}
