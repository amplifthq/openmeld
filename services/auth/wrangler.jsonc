{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmeld-auth",
  "main": "src/index.ts",
  // Better Auth is request-only. Keep it in an additional module so Worker
  // startup does not parse the complete auth, passkey, and certificate stack.
  "base_dir": "src",
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/generated-runtime/*.mjs"]
    }
  ],
  "build": {
    "command": "pnpm --filter @openmeld/auth-worker run build:lazy-runtime-modules"
  },
  "compatibility_date": "2026-02-18",
  "compatibility_flags": ["nodejs_compat"],
  // Periodic Auth convergence: self-heals dropped Space Index overlay writes
  // and retries durable Profile-deletion lifecycle work. Per-env triggers do
  // not inherit, so the prod block below repeats this.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "placement": {
    "mode": "smart"
  },
  "dev": {
    "ip": "localhost",
    "port": 8788,
    "inspector_port": 9231
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "OPENMELD_OBSERVABILITY",
      "dataset": "openmeld_runtime_evidence"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "OPENMELD_ORGANIZATION_JOIN_LINK_ACCEPT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "route": {
    "custom_domain": true,
    "pattern": "auth.openmeld.ai"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_OPENMELD_SECRET",
      "GITHUB_OPENMELD_AUTH_OAUTH_CLIENT_SECRET",
      "GOOGLE_OPENMELD_AUTH_OAUTH_CLIENT_SECRET"
    ]
  },
  "vars": {
    // Production deploys set the exact source with --var RELEASE_SHA:<sha>.
    "RELEASE_SHA": "",
    "OPENMELD_WORKER_ENVIRONMENT": "local",
    "BETTER_AUTH_URL": "http://localhost:8788",
    "WEB_APP_URL": "http://localhost:3000",
    "AUTH_WORKER_NODE_ENV": "development",
    "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
    "AUTH_DEVICE_ALLOWED_CLIENT_IDS": "openmeld-cli,openmeld-cli-dev",
    "OPENMELD_ADDITIONAL_HUMAN_PROFILE_CREATION_ENABLED": "false",
    "AUTH_BRAND_NAME": "OpenMeld",
    "AUTH_FROM_EMAIL": "OpenMeld <noreply@openmeld.ai>",
    "GITHUB_OPENMELD_AUTH_OAUTH_CLIENT_ID": "Ov23li9ucKsimG997WY9",
    "GOOGLE_OPENMELD_AUTH_OAUTH_CLIENT_ID": "658840510621-6onjj4k6t6k7e7t54qitoqu1keilsri2.apps.googleusercontent.com",
    "AUTH_COOKIE_DOMAIN": "localhost",
    "PASSKEY_RP_ID": "localhost",
    "AUTH_MAGIC_LINK_EXPIRES_IN_SECONDS": "300"
  },
  "hyperdrive": [
    {
      "binding": "OPENMELD_POSTGRESQL",
      "id": "dba7d43fe644409c8e1cc24c5260f289"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OPENMELD_AUTH_KV",
      "id": "89407cf3ca6c4df9928b2e7c4c001aba"
    }
  ],
  "services": [
    {
      "binding": "OPENMELD_CORE_WORKER",
      "service": "openmeld-core",
      "entrypoint": "ProfileLifecycleEntrypoint"
    }
  ],
  "env": {
    "stg": {
      "route": {
        "custom_domain": true,
        "pattern": "auth.staging.openmeld.ai"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_stg"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        }
      ],
      "ratelimits": [
        {
          "name": "OPENMELD_ORGANIZATION_JOIN_LINK_ACCEPT_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "secrets": {
        "required": ["BETTER_AUTH_OPENMELD_SECRET"]
      },
      "vars": {
        // Production deploys set the exact source with --var RELEASE_SHA:<sha>.
        "RELEASE_SHA": "",
        "OPENMELD_WORKER_ENVIRONMENT": "stg",
        "BETTER_AUTH_URL": "https://auth.staging.openmeld.ai",
        "WEB_APP_URL": "https://app.staging.openmeld.ai",
        "AUTH_LEGACY_APP_ORIGIN": "https://staging.openmeld.ai",
        "AUTH_WORKER_NODE_ENV": "production",
        "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
        "AUTH_DEVICE_ALLOWED_CLIENT_IDS": "openmeld-cli,openmeld-cli-dev",
        "OPENMELD_ADDITIONAL_HUMAN_PROFILE_CREATION_ENABLED": "false",
        "AUTH_BRAND_NAME": "OpenMeld",
        "AUTH_FROM_EMAIL": "OpenMeld <noreply@openmeld.ai>",
        "AUTH_COOKIE_DOMAIN": "staging.openmeld.ai",
        "AUTH_COOKIE_PREFIX": "openmeld-staging",
        "PASSKEY_RP_ID": "staging.openmeld.ai",
        "AUTH_MAGIC_LINK_EXPIRES_IN_SECONDS": "300"
      },
      "hyperdrive": [
        {
          "binding": "OPENMELD_POSTGRESQL",
          "id": "6af2d43ec8d8498b9607c653ca231e73"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OPENMELD_AUTH_KV",
          "id": "ce0678aff60e4d5b864ad0591ea5e88a"
        }
      ],
      "services": [
        {
          "binding": "OPENMELD_CORE_WORKER",
          "service": "openmeld-core-stg",
          "entrypoint": "ProfileLifecycleEntrypoint"
        }
      ]
    },
    "prod": {
      // Per-env triggers do not inherit the top-level block; declare the Auth
      // convergence cron explicitly for the prod deploy.
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "analytics_engine_datasets": [
        {
          "binding": "OPENMELD_OBSERVABILITY",
          "dataset": "openmeld_runtime_evidence_prod"
        }
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL"
        }
      ],
      "ratelimits": [
        {
          "name": "OPENMELD_ORGANIZATION_JOIN_LINK_ACCEPT_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_OPENMELD_SECRET",
          "GITHUB_OPENMELD_AUTH_OAUTH_CLIENT_SECRET",
          "GOOGLE_OPENMELD_AUTH_OAUTH_CLIENT_SECRET"
        ]
      },
      "vars": {
        // Production deploys set the exact source with --var RELEASE_SHA:<sha>.
        "RELEASE_SHA": "",
        "OPENMELD_WORKER_ENVIRONMENT": "prod",
        "BETTER_AUTH_URL": "https://auth.openmeld.ai",
        "WEB_APP_URL": "https://app.openmeld.ai",
        "AUTH_LEGACY_APP_ORIGIN": "https://openmeld.ai",
        "AUTH_WORKER_NODE_ENV": "production",
        "AUTH_DESKTOP_DEVELOPMENT_TARGET": "",
        "AUTH_DEVICE_ALLOWED_CLIENT_IDS": "openmeld-cli,openmeld-cli-dev",
        "OPENMELD_ADDITIONAL_HUMAN_PROFILE_CREATION_ENABLED": "false",
        "AUTH_BRAND_NAME": "OpenMeld",
        "AUTH_FROM_EMAIL": "OpenMeld <noreply@openmeld.ai>",
        "GITHUB_OPENMELD_AUTH_OAUTH_CLIENT_ID": "Ov23linQIGHXoXdtYZYC",
        "GOOGLE_OPENMELD_AUTH_OAUTH_CLIENT_ID": "658840510621-hfkvpi151d1tgqlg2qsr5nh7p7cgrr9m.apps.googleusercontent.com",
        "AUTH_COOKIE_DOMAIN": "openmeld.ai",
        "PASSKEY_RP_ID": "openmeld.ai",
        "AUTH_MAGIC_LINK_EXPIRES_IN_SECONDS": "300"
      },
      "hyperdrive": [
        {
          "binding": "OPENMELD_POSTGRESQL",
          "id": "dba7d43fe644409c8e1cc24c5260f289"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OPENMELD_AUTH_KV",
          "id": "89407cf3ca6c4df9928b2e7c4c001aba"
        }
      ],
      "services": [
        {
          "binding": "OPENMELD_CORE_WORKER",
          "service": "openmeld-core-prod",
          "entrypoint": "ProfileLifecycleEntrypoint"
        }
      ]
    }
  }
}
