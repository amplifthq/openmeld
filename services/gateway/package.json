{
  "name": "@openmeld/gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenMeld - Gateway",
  "license": "MIT",
  "scripts": {
    "predev": "node ../../scripts/dev/run-guarded-service-predev.mjs gateway \"pnpm -C ../.. exec turbo run build --filter=@openmeld/gateway\"",
    "dev": "dotenv -e ../../.env -o -- wrangler dev --persist-to ../../.wrangler-dev-state --inspector-port 19332",
    "predev:isolated": "node ../../scripts/dev/run-guarded-service-predev.mjs gateway \"pnpm -C ../.. exec turbo run build --filter=@openmeld/gateway\"",
    "dev:isolated": "dotenv -e ../../.env -- node ../../scripts/dev/run-isolated-worker-dev.mjs gateway",
    "dev:prod": "dotenv -e ../../.env -o -- wrangler dev --env prod --persist-to ../../.wrangler-dev-state --inspector-port 19332",
    "build:workspace-dependencies": "pnpm -C ../.. exec turbo run build --filter=@openmeld/gateway^...",
    "deploy": "pnpm run build:workspace-dependencies && dotenv -e ../../.env -o -- wrangler deploy --minify --env prod",
    "deploy:stg": "pnpm run build:workspace-dependencies && wrangler deploy --minify --env stg",
    "sync:config:prod": "pnpm run deploy",
    "sync:config:stg": "pnpm run deploy:stg",
    "sync:secrets:slack:stg": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env stg --from-env SLACK_OPENMELD_OAUTH_CLIENT_ID SLACK_OPENMELD_OAUTH_CLIENT_SECRET SLACK_OPENMELD_SIGNING_SECRET",
    "sync:secrets:connectors:stg": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env stg --from-env OPEN_CONNECTOR_OPENMELD_ADMIN_TOKEN OPEN_CONNECTOR_OPENMELD_RUNTIME_TOKEN",
    "sync:secrets:prod": "node ../../scripts/cloudflare/sync-worker-secrets.mjs --env prod --file .dev.vars.prod SLACK_OPENMELD_OAUTH_CLIENT_ID SLACK_OPENMELD_OAUTH_CLIENT_SECRET SLACK_OPENMELD_SIGNING_SECRET OPEN_CONNECTOR_OPENMELD_ADMIN_TOKEN OPEN_CONNECTOR_OPENMELD_RUNTIME_TOKEN",
    "sync:prod": "pnpm run sync:secrets:prod && pnpm run sync:config:prod",
    "sync:stg": "pnpm run sync:config:stg",
    "test": "node --test scripts/test.test.mjs && node scripts/test.mjs",
    "test:local-smoke": "vitest run --config vitest.local-smoke.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck",
    "cf-typegen": "wrangler types -c ./wrangler.jsonc -c ../core/wrangler.jsonc -c ../auth/wrangler.jsonc --env-interface=CloudflareBindings && pnpm run typecheck"
  },
  "dependencies": {
    "@openmeld/gateway-contract": "workspace:*",
    "@openmeld/protocol": "workspace:*",
    "@openmeld/schemas": "workspace:*",
    "@openmeld/space": "workspace:*",
    "@openmeld/utils": "workspace:*",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@openmeld/auth-worker": "workspace:*",
    "@openmeld/core": "workspace:*",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "dotenv-cli": "^11.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11",
    "wrangler": "catalog:"
  }
}
