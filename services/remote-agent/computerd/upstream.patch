@@ -0,0 +1,72 @@
+import { expect, it } from "vitest";
+import { withDB } from "../fs/with-db.js";
+import { mkdir } from "../fs/mkdir.js";
+import { writeFile } from "../fs/writeFile.js";
+import { readFile } from "../fs/readFile.js";
+import { link } from "../fs/link.js";
+import { symlink } from "../fs/symlink.js";
+import { invalidateReadOnlyMountCache } from "../fs/mount-guard.js";
+import { resolveInode } from "../fs/resolve.js";
+import { applyChangesSync } from "./apply.js";
+import { drainSyncRemovals } from "./removals.js";
+import { materialiseChange } from "./changes.js";
+import { currentRev } from "./watermarks.js";
+
+it("detaches a large tree atomically and reaps old inodes without harming a recreated tree or outside hardlink", async () => {
+  await withDB(async (db) => {
+    mkdir(db, "/d", {}, Date.now);
+    for (let i = 0; i < 2_000; i++) await writeFile(db, `/d/f${i}`, `${i}`, {}, Date.now);
+    link(db, "/d/f1999", "/keep");
+    db.transactionSync(() =>
+      applyChangesSync(db, [{ kind: "delete", path: "/d", rev: 10 }], new Map(), {
+        sourceCursor: { rev: 0, path: null },
+      }),
+    );
+    expect(resolveInode(db, "/d")).toBeNull();
+    expect(db.scalar<number>("SELECT COUNT(*) FROM vfs_nodes")).toBeGreaterThan(2_000);
+    expect(drainSyncRemovals(db)).toBe(false);
+    mkdir(db, "/d", {}, Date.now);
+    await writeFile(db, "/d/f1999", "new subtree", {}, Date.now);
+    await writeFile(db, "/keep", "outside update", {}, Date.now);
+    let pages = 0;
+    while (!drainSyncRemovals(db)) expect(++pages).toBeLessThan(100);
+    expect(pages).toBeGreaterThan(1);
+    expect(await readFile(db, "/d/f1999", "utf8")).toBe("new subtree");
+    expect(await readFile(db, "/keep", "utf8")).toBe("outside update");
+    expect(db.scalar<number>("SELECT COUNT(*) FROM _vfs_sync_removals")).toBe(0);
+  });
+});
+
+it("does not replace a newer tombstone with delayed deletion of the old subtree", async () => {
+  await withDB(async (db) => {
+    mkdir(db, "/d", {}, Date.now);
+    await writeFile(db, "/d/x", "old", {}, Date.now);
+    applyChangesSync(db, [{ kind: "delete", path: "/d", rev: 10 }], new Map());
+    mkdir(db, "/d", {}, Date.now);
+    await writeFile(db, "/d/x", "new", {}, Date.now);
+    applyChangesSync(db, [{ kind: "delete", path: "/d/x", rev: 11 }], new Map());
+    const latest = currentRev(db);
+    while (!drainSyncRemovals(db)) {}
+    expect(materialiseChange(db, "/d/x")).toMatchObject({ kind: "delete", rev: latest });
+  });
+});
+
+it.each(["/alias/answer", "/alias/sub/answer"])(
+  "preserves read-only files when deletion traverses a symlink: %s",
+  async (path) => {
+    await withDB(async (db) => {
+      mkdir(db, "/protected/sub", { recursive: true }, Date.now);
+      await writeFile(db, "/protected/answer", "keep", {}, Date.now);
+      await writeFile(db, "/protected/sub/answer", "keep", {}, Date.now);
+      symlink(db, "/protected", "/alias", Date.now);
+      db.run(
+        "INSERT INTO _vfs_mounts(root,kind,indexed,mode) VALUES('/protected','r2',1,'read-only')",
+      );
+      invalidateReadOnlyMountCache(db);
+      expect(() => applyChangesSync(db, [{ kind: "delete", path, rev: 99 }], new Map())).toThrow(
+        /read-only/,
+      );
+      expect(await readFile(db, path.replace("/alias", "/protected"), "utf8")).toBe("keep");
+    });
+  },
+);
diff --git a/packages/dofs/src/sync/removals.ts b/packages/dofs/src/sync/removals.ts
new file mode 100644
index 0000000..22153f8
--- /dev/null
+++ b/packages/dofs/src/sync/removals.ts
@@ -0,0 +1,80 @@
+import type { Database } from "../storage.js";
+import { recordDelete } from "./changes.js";
+
+export const REMOVAL_STATEMENT = `CREATE TABLE IF NOT EXISTS _vfs_sync_removals (
+  inode INTEGER PRIMARY KEY, change_id INTEGER NOT NULL, rev INTEGER NOT NULL,
+  priority INTEGER NOT NULL
+)`;
+
+// Detaching one name commits namespace removal without traversing its tree.
+// Only unreachable inodes are queued; outside hardlinks retain their contents.
+export function detachForSync(
+  db: Database,
+  parent: number,
+  name: string,
+  inode: number,
+  path: string,
+  rev: number,
+): void {
+  const changeId = recordDelete(db, rev, path);
+  db.run("DELETE FROM vfs_dirents WHERE parent_inode=? AND name=?", parent, name);
+  if (!db.one("SELECT 1 FROM vfs_dirents WHERE child_inode=? LIMIT 1", inode)) {
+    db.run(
+      "INSERT OR IGNORE INTO _vfs_sync_removals(inode,change_id,rev,priority) VALUES(?,?,?,?)",
+      inode,
+      changeId,
+      rev,
+      path.length,
+    );
+  }
+}
+
+// Durable bounded post-detach reclamation. Each unit removes one name, one
+// inode, or at most 256 chunk references. Blob bytes retain their normal GC
+// owner. A restart resumes the same queue; no JS stack is authoritative.
+export function drainSyncRemovals(db: Database): boolean {
+  return db.transactionSync(() => {
+    if (db.one("SELECT 1 FROM _vfs_sync_removals LIMIT 1")) db.requestMaintenance();
+    for (let work = 0; work < 128; work++) {
+      const task = db.one<{ inode: number; path: string; rev: number }>(
+        `SELECT r.inode,c.path,r.rev FROM _vfs_sync_removals r
+         JOIN vfs_changes c ON c.id=r.change_id
+         ORDER BY r.priority DESC,r.inode LIMIT 1`,
+      );
+      if (!task) return true;
+      const child = db.one<{ name: string; child_inode: number }>(
+        "SELECT name,child_inode FROM vfs_dirents WHERE parent_inode=? ORDER BY name LIMIT 1",
+        task.inode,
+      );
+      if (child) {
+        detachForSync(
+          db,
+          task.inode,
+          child.name,
+          child.child_inode,
+          `${task.path}/${child.name}`,
+          task.rev,
+        );
+        continue;
+      }
+      // Bound a large file's metadata cleanup independently of directory size.
+      const chunks = db.all<{ idx: number }>(
+        "SELECT idx FROM vfs_chunks WHERE inode=? ORDER BY idx LIMIT ?",
+        task.inode,
+        128 - work,
+      );
+      if (chunks.length) {
+        db.run(
+          "DELETE FROM vfs_chunks WHERE inode=? AND idx<=?",
+          task.inode,
+          chunks[chunks.length - 1]!.idx,
+        );
+        work += chunks.length;
+      }
+      if (db.one("SELECT 1 FROM vfs_chunks WHERE inode=? LIMIT 1", task.inode)) return false;
+      db.run("DELETE FROM vfs_nodes WHERE inode=?", task.inode);
+      db.run("DELETE FROM _vfs_sync_removals WHERE inode=?", task.inode);
+    }
+    return !db.one("SELECT 1 FROM _vfs_sync_removals LIMIT 1");
+  });
+}
diff --git a/packages/dofs/src/sync/retention.ts b/packages/dofs/src/sync/retention.ts
new file mode 100644
index 0000000..e957cc1
--- /dev/null
+++ b/packages/dofs/src/sync/retention.ts
@@ -0,0 +1,135 @@
+import type { Database } from "../storage.js";
+import { discardChangePlanStep, retireChangePlan } from "./planning.js";
+import { drainSyncRemovals } from "./removals.js";
+import { prepareDeleteReservesStep } from "./changes.js";
+
+// References, not time, decide when content can be removed. Sync references
+// survive process eviction. An unfinished local stream cannot survive eviction,
+// so its temporary references deliberately live only with that stream.
+export const RETENTION_STATEMENTS = [
+  `CREATE INDEX IF NOT EXISTS _vfs_sync_removals_priority ON _vfs_sync_removals(priority DESC,inode)`,
+  `CREATE TABLE IF NOT EXISTS _vfs_blob_pins (
+    owner TEXT NOT NULL, hash BLOB NOT NULL, PRIMARY KEY(owner,hash)
+  ) WITHOUT ROWID`,
+  `CREATE INDEX IF NOT EXISTS _vfs_blob_pins_hash ON _vfs_blob_pins(hash,owner)`,
+  `CREATE TABLE IF NOT EXISTS _vfs_retention_slots (
+    slot TEXT PRIMARY KEY, generation TEXT NOT NULL, closed INTEGER NOT NULL DEFAULT 0
+  )`,
+  `CREATE TABLE IF NOT EXISTS _vfs_gc_cursor (kind TEXT PRIMARY KEY, hash BLOB NOT NULL, done INTEGER NOT NULL DEFAULT 0)`,
+  `CREATE TABLE IF NOT EXISTS _vfs_gc_state (slot INTEGER PRIMARY KEY, dirty INTEGER NOT NULL, sweep INTEGER NOT NULL, active INTEGER NOT NULL)`,
+  `INSERT OR IGNORE INTO _vfs_gc_state(slot,dirty,sweep,active) VALUES(1,0,0,0)`,
+];
+
+export interface RetentionScope {
+  epoch: string;
+  slot: string;
+  generation: string;
+}
+
+export function retentionHead(db: Database, slot: string) {
+  return {
+    epoch: db.scalar<string>("SELECT epoch FROM _vfs_sync_identity WHERE slot='self'")!,
+    generation: db.scalar<string>("SELECT generation FROM _vfs_retention_slots WHERE slot=?", slot) ?? null,
+  };
+}
+
+export function assertRetention(db: Database, scope: RetentionScope): void {
+  const head = retentionHead(db, scope.slot);
+  if (head.epoch !== scope.epoch || head.generation !== scope.generation ||
+      db.scalar<number>("SELECT closed FROM _vfs_retention_slots WHERE slot=?", scope.slot) !== 0) {
+    throw new Error("ESYNC_STALE_RETENTION: transfer owner changed; cursor unchanged");
+  }
+}
+
+export function beginRetention(db: Database, scope: RetentionScope, expectedGeneration: string | null): void {
+  db.transactionSync(() => {
+    const head = retentionHead(db, scope.slot);
+    if (head.epoch !== scope.epoch) throw new Error("ESYNC_STALE_RETENTION: receiver replaced");
+    if (head.generation === scope.generation) return assertRetention(db, scope);
+    if (head.generation !== expectedGeneration) throw new Error("ESYNC_STALE_RETENTION: owner changed");
+    if (head.generation !== null) retireChangePlan(db, head.generation);
+    db.run(`INSERT INTO _vfs_retention_slots(slot,generation,closed) VALUES(?,?,0)
+      ON CONFLICT(slot) DO UPDATE SET generation=excluded.generation,closed=0`, scope.slot, scope.generation);
+  });
+}
+
+export function pinBlobs(db: Database, owner: string, hashes: readonly Uint8Array[]): void {
+  for (const hash of hashes) {
+    if (db.one("SELECT 1 FROM _vfs_blob_pins WHERE owner=? AND hash=?", owner, hash)) continue;
+    db.assertContentCapacity(owner.length * 2 + hash.length + 512);
+    db.run("INSERT INTO _vfs_blob_pins(owner,hash) VALUES(?,?)", owner, hash);
+  }
+}
+
+export { retireChangePlan as retirePins } from "./planning.js";
+
+export function releasePinsStep(db: Database, owner: string): boolean {
+  if (db.one("SELECT 1 FROM _vfs_blob_pins WHERE owner=? LIMIT 1", owner)) db.requestMaintenance();
+  db.run(`DELETE FROM _vfs_blob_pins WHERE owner=? AND hash IN
+    (SELECT hash FROM _vfs_blob_pins WHERE owner=? ORDER BY hash LIMIT 128)`, owner, owner);
+  return !db.one("SELECT 1 FROM _vfs_blob_pins WHERE owner=? LIMIT 1", owner);
+}
+
+const streams = new WeakMap<Database["sql"], Map<string, Set<string>>>();
+const key = (hash: Uint8Array) => Array.from(hash, b => b.toString(16).padStart(2, "0")).join("");
+export function localStreamPins(db: Database) {
+  let owners = streams.get(db.sql);
+  if (!owners) streams.set(db.sql, owners = new Map());
+  const owner = crypto.randomUUID();
+  const hashes = new Set<string>();
+  owners.set(owner, hashes);
+  return { add: (hash: Uint8Array) => hashes.add(key(hash)), release: () => {
+    if (owners!.delete(owner)) db.requestMaintenance();
+  } };
+}
+
+// Exactly one indexed page of candidates per table. Filtering before LIMIT
+// would make a mostly-live filesystem scan its entire store on every call.
+export function collectContentStep(db: Database, limit = 128): { complete: boolean; freed: number } {
+  const ready = db.scalar<number>("SELECT complete FROM _vfs_delete_reserve_preparation WHERE slot=1") === 1;
+  const result = db.transactionSync(() => {
+    if (db.scalar<number>("SELECT active FROM _vfs_gc_state WHERE slot=1") === 0) {
+      db.run("UPDATE _vfs_gc_cursor SET hash=?,done=0", new Uint8Array());
+    }
+    db.run("UPDATE _vfs_gc_state SET sweep=dirty,active=1 WHERE slot=1 AND active=0");
+    let complete = ready && drainSyncRemovals(db);
+    let scanComplete = true;
+    let freed = 0;
+    const retired = db.scalar<string>("SELECT generation FROM _vfs_retired_change_plans LIMIT 1");
+    if (retired !== undefined) {
+      if (discardChangePlanStep(db, retired, false)) db.run("DELETE FROM _vfs_retired_change_plans WHERE generation=?", retired);
+      else complete = false;
+    }
+    if (db.one("SELECT 1 FROM _vfs_retired_change_plans LIMIT 1")) complete = false;
+    for (const kind of ["blobs", "manifests"] as const) {
+      if (db.scalar<number>("SELECT done FROM _vfs_gc_cursor WHERE kind=?", kind) === 1) continue;
+      const after = db.scalar<Uint8Array>("SELECT hash FROM _vfs_gc_cursor WHERE kind=?", kind) ?? new Uint8Array();
+      const rows = db.all<{ hash: Uint8Array }>(`SELECT hash FROM vfs_${kind} WHERE hash>? ORDER BY hash LIMIT ?`, after, limit);
+      for (const { hash } of rows) {
+        if (kind === "blobs") {
+          if (db.one("SELECT 1 FROM vfs_chunks WHERE hash=? LIMIT 1", hash) ||
+              db.one("SELECT 1 FROM _vfs_blob_pins WHERE hash=? LIMIT 1", hash) ||
+              [...(streams.get(db.sql)?.values() ?? [])].some(set => set.has(key(hash)))) continue;
+          // Explicit child deletion also works on adapters without FK enforcement.
+          db.run("DELETE FROM vfs_blob_bytes WHERE hash=?", hash);
+        } else if (db.one("SELECT 1 FROM vfs_nodes WHERE manifest_hash=? LIMIT 1", hash)) continue;
+        db.run(`DELETE FROM vfs_${kind} WHERE hash=?`, hash);
+        freed++;
+      }
+      const more = rows.length === limit;
+      scanComplete &&= !more;
+      db.run(`INSERT INTO _vfs_gc_cursor(kind,hash,done) VALUES(?,?,?)
+        ON CONFLICT(kind) DO UPDATE SET hash=excluded.hash,done=excluded.done`, kind, rows.at(-1)?.hash ?? after, more ? 0 : 1);
+    }
+    if (scanComplete) {
+      const state = db.one<{ dirty: number; sweep: number }>("SELECT dirty,sweep FROM _vfs_gc_state WHERE slot=1")!;
+      db.run("UPDATE _vfs_gc_state SET active=0 WHERE slot=1");
+      complete &&= state.dirty === state.sweep;
+    } else complete = false;
+    return { complete, freed };
+  });
+  // Commit orphan reclamation before migration allocation. A quota refusal
+  // must not roll back reclaimed space that the migration itself needs.
+  if (!ready) db.transactionSync(() => prepareDeleteReservesStep(db));
+  return result;
+}
