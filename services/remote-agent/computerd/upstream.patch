@@ -0,0 +1,38 @@
+// Connection-scoped evidence from the authenticated native information route.
+// A known older response may omit execution support. An unreadable or malformed
+// response must never authorize the legacy command path.
+export type ExecutionSupervision = { version: 0 } | { version: 1; epoch: string };
+
+export async function readComputerdInfo(fetchInfo: () => Promise<Response>): Promise<{
+  body: Record<string, unknown>;
+  executionSupervision: ExecutionSupervision;
+}> {
+  const response = await fetchInfo();
+  if (!response.ok) throw new Error(`computerd info request failed: HTTP ${response.status}`);
+  const body: unknown = await response.json();
+  const record = (value: unknown): value is Record<string, unknown> =>
+    value !== null && typeof value === "object" && !Array.isArray(value);
+  if (
+    !record(body) ||
+    !record(body.backend) ||
+    typeof body.backend.kind !== "string" ||
+    typeof body.mountPoint !== "string" ||
+    !body.mountPoint.startsWith("/") ||
+    !Number.isInteger(body.port) ||
+    !record(body.store) ||
+    typeof body.store.kind !== "string"
+  ) {
+    throw new Error("Malformed computerd info response");
+  }
+  if (!("execution" in body)) return { body, executionSupervision: { version: 0 } };
+  const execution = body.execution;
+  if (
+    !record(execution) ||
+    execution.supervision !== 1 ||
+    typeof execution.epoch !== "string" ||
+    execution.epoch.length === 0
+  ) {
+    throw new Error("Unsupported or malformed computerd execution supervision");
+  }
+  return { body, executionSupervision: { version: 1, epoch: execution.epoch } };
+}
