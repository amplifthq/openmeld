+    let injected = false;
+    let afterApplyWrite = false;
+    let sawReceipt = false;
+    let flushCalls = 0;
+    let replayedEmptyFlush = false;
+    try {
+      source.fs.mkdirSync("/work");
+      for (let i = 0; i < 300; i++) source.fs.writeFileSync(`/work/${i}`, `original-${i}`);
+      for (let steps = 0; ; steps++) {
