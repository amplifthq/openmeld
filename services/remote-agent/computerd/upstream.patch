+it.each(["push-response", "flush", "ack-request", "ack-response", "replacement"])(
+  "resumes the durable receipt after %s loss and reopening both databases",
+  async (fault) => {
+    const directory = mkdtempSync(join(tmpdir(), "computer-import-"));
+    const open = (name: string) => {
+      const storage = new NodeSQLiteStorage({ location: join(directory, name) });
+      const db = new Database(storage);
