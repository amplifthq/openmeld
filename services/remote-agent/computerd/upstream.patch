index 0000000..f0e0163
--- /dev/null
+++ b/packages/dofs/src/sync/refusals.ts
@@ -0,0 +1,126 @@
+import type { Database } from "../storage.js";
+import type { ChangeCursor } from "./watermarks.js";
+import type { SkippedEntry } from "./apply.js";
+import { cursorSortKey } from "./planning.js";
+
+export const REFUSAL_STATEMENT = `CREATE TABLE IF NOT EXISTS _vfs_sync_refusals (
+  backend TEXT NOT NULL, epoch TEXT NOT NULL, rev INTEGER NOT NULL, sort_key BLOB NOT NULL,
+  path TEXT NOT NULL, mount_root TEXT NOT NULL, reason TEXT NOT NULL, op TEXT NOT NULL,
+  PRIMARY KEY(backend,epoch,rev,sort_key)
+) WITHOUT ROWID`;
+
+export function cursorLowerBound(cursor: ChangeCursor): { rev: number; key: Uint8Array } {
+  return cursor.path === null
+    ? { rev: cursor.rev + 1, key: new Uint8Array() }
+    : { rev: cursor.rev, key: cursorSortKey(cursor.path) };
+}
+
+export function recordSyncRefusal(
+  db: Database,
+  backend: string,
+  epoch: string,
+  rev: number,
+  skipped: SkippedEntry,
+): void {
+  db.run(
+    "INSERT OR IGNORE INTO _vfs_sync_refusals(backend,epoch,rev,sort_key,path,mount_root,reason,op) VALUES(?,?,?,?,?,?,?,?)",
+    backend,
+    epoch,
+    rev,
+    cursorSortKey(skipped.path),
+    skipped.path,
+    skipped.mountRoot,
+    skipped.reason,
+    skipped.op,
+  );
+}
+
+export function readSyncRefusals(
+  db: Database,
+  backend: string,
+  epoch: string,
+  start: { rev: number; key: Uint8Array },
+  through: number,
+): { skipped: SkippedEntry[]; skippedTruncated: boolean } {
+  const rows = db.all<{
+    path: string;
+    mount_root: string;
+    reason: "read-only";
+    op: "write" | "delete";
+  }>(
+    `SELECT path,mount_root,reason,op FROM _vfs_sync_refusals WHERE backend=? AND epoch=?
+      AND (rev,sort_key)>(?,?) AND rev<=? ORDER BY rev,sort_key LIMIT 17`,
+    backend,
+    epoch,
+    start.rev,
+    start.key,
+    through,
+  );
+  return {
+    skipped: rows
+      .slice(0, 16)
+      .map((row) => ({
+        path: row.path,
+        mountRoot: row.mount_root,
+        reason: row.reason,
+        op: row.op,
+      })),
+    skippedTruncated: rows.length > 16,
+  };
+}
+
+// The execution owner supplies the earliest still-needed cursor. This module
+// never reads another owner's execution tables or invents a TTL for its pins.
+export function pruneSyncRefusals(
+  db: Database,
+  backend: string,
+  epoch: string,
+  floor: { rev: number; key: Uint8Array },
+): boolean {
+  const rows = db.all<{ rev: number; sort_key: Uint8Array }>(
+    `SELECT rev,sort_key FROM _vfs_sync_refusals
+    WHERE backend=? AND epoch=? AND (rev,sort_key)<=(?,?) ORDER BY rev,sort_key LIMIT 256`,
+    backend,
+    epoch,
+    floor.rev,
+    floor.key,
+  );
+  for (const row of rows)
+    db.run(
+      "DELETE FROM _vfs_sync_refusals WHERE backend=? AND epoch=? AND rev=? AND sort_key=?",
+      backend,
+      epoch,
+      row.rev,
+      row.sort_key,
+    );
+  return !!db.one(
+    "SELECT 1 FROM _vfs_sync_refusals WHERE backend=? AND epoch=? AND (rev,sort_key)<=(?,?) LIMIT 1",
+    backend,
+    epoch,
+    floor.rev,
+    floor.key,
+  );
+}
+
+export function readSyncPeerEpoch(db: Database, backend: string): string | undefined {
+  return db.scalar<string>("SELECT epoch FROM _vfs_sync_identity WHERE slot=?", `peer:${backend}`);
+}
+
+export function oldSyncRefusalEpoch(
+  db: Database,
+  backend: string,
+  current: string,
+): string | undefined {
+  return (
+    db.scalar<string>(
+      "SELECT epoch FROM _vfs_sync_refusals WHERE backend=? AND epoch<? ORDER BY epoch LIMIT 1",
+      backend,
+      current,
+    ) ??
+    db.scalar<string>(
+      "SELECT epoch FROM _vfs_sync_refusals WHERE backend=? AND epoch>? ORDER BY epoch LIMIT 1",
+      backend,
+      current,
+    )
+  );
+}
