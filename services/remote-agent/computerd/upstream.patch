+import { env } from "cloudflare:test";
+import { expect, it } from "vitest";
+import { getWorkspace } from "../src/client.js";
+import type { Env } from "./execution-sync-worker.js";
+
+declare module "cloudflare:test" {
+  interface ProvidedEnv extends Env {}
+}
+
+it("rolls back a failed object batch through actual Workers nested transactions", async () => {
+  const owner = env.WORKSPACE.get(env.WORKSPACE.newUniqueId());
+  expect(await owner.objectBatchRollback()).toEqual({
+    originalError: true, writes: 2, objects: 0, pins: 0, dirtyDelta: 0,
+    cursor: { rev: 0, path: null }, receipts: 0,
+  });
+});
+
+it.each(["runtime", "epoch", "retired epoch"] as const)(
+  "preserves typed %s loss through SQLite Workspace, Workers RPC and WorkspaceClient",
+  async (loss) => {
+    const owner = env.WORKSPACE.get(env.WORKSPACE.newUniqueId());
+    await owner.prepare(loss);
+    using client = await getWorkspace(owner);
+    let failure: unknown;
+    try {
+      await client.resumeExecutionSync("original", "peer", { executionExited: true });
+    } catch (error) {
+      failure = error;
+    }
+    expect(failure).toMatchObject({ name: "WorkspaceExecutionLostError", code: "EEXEC_LOST" });
+    expect(await owner.nativeCalls()).toBe(0);
+  },
+);
