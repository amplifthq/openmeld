+import { createSyncServer, createWorkspaceServer } from "@cloudflare/computer-rpc/server";
+import { Database, initializeSchema, SQLiteWorkspaceProvider } from "@cloudflare/dofs";
+import { SQLiteTestStorage } from "@cloudflare/dofs/testing";
+import type { ShellRPC, ExecEvent } from "@cloudflare/computer-rpc";
+import { expect, it } from "vitest";
+import { Workspace } from "./workspace.js";
+import type { WorkspaceBackend } from "./backend.js";
+import { WorkspaceSyncPendingError } from "./sync-pending.js";
+
+it("requests maintenance for filesystem-only writes, deletion and stream release", async () => {
+  const storage = new SQLiteTestStorage();
+  let kicks = 0;
+  const ws = new Workspace({ storage, onMaintenanceNeeded: () => { kicks++; } });
+  try {
+    await ws.fs.mkdir("/tree");
+    await ws.fs.writeFile("/tree/result", new Uint8Array(2 * 512 * 1024).fill(7));
+    expect(kicks).toBeGreaterThan(0);
+    const stream = await ws.fs.readFile("/tree/result");
+    kicks = 0;
+    await ws.fs.rm("/tree", { recursive: true });
+    expect(kicks).toBeGreaterThan(0);
+    while (await ws.maintainSync()) {}
+    kicks = 0;
+    await stream.cancel();
+    expect(kicks).toBeGreaterThan(0);
+    while (await ws.maintainSync()) {}
+    const db = new Database(storage);
+    expect(db.scalar("SELECT count(*) FROM vfs_blob_bytes")).toBe(0);
+  } finally { await ws.close(); storage.close(); }
+});
+
+it("serializes delayed epoch admission with other commands and maintenance", async () => {
+  const local = new SQLiteTestStorage(),
+    oldStorage = new SQLiteTestStorage(),
+    freshStorage = new SQLiteTestStorage();
+  const old = new Database(oldStorage),
+    fresh = new Database(freshStorage);
+  initializeSchema(old, Date.now);
+  initializeSchema(fresh, Date.now);
+  let remote = old;
+  const starts: string[] = [];
+  const envelope = (id: string) => ({
+    id,
+    events: new ReadableStream<ExecEvent>({
+      start(c) {
+        c.enqueue({ id, seq: 1, name: "exit", code: 0 });
+        c.close();
+      },
+    }),
+  });
+  const runner = {
+    exec(_source: string, options?: { id?: string }) {
+      const id = options!.id!;
+      starts.push(id);
+      new SQLiteWorkspaceProvider(remote).writeFileSync(`/${id}`, "saved");
+      return envelope(id);
+    },
+    get: envelope,
+    kill() {},
+    dispose() {},
+  };
+  let rpc = createWorkspaceServer(remote, runner);
+  let armed = false,
+    captured = false,
+    replaced = false;
+  const held = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  const sync: typeof rpc.sync = new Proxy({} as typeof rpc.sync, {
+    get(_target, key: keyof typeof rpc.sync) {
+      if (key === "watermarks")
+        return async (input?: { settle?: boolean }) => {
+          const snapshot = await rpc.sync.watermarks(input);
+          if (armed && !captured) {
+            captured = true;
+            held.resolve();
+            await release.promise;
+          }
+          return snapshot;
+        };
+      if (key === "discardChanges")
+        return async (...args: Parameters<NonNullable<typeof rpc.sync.discardChanges>>) => {
+          const done = await rpc.sync.discardChanges!(...args);
+          if (done) armed = true;
+          return done;
+        };
+      return (...args: unknown[]) => Reflect.apply(rpc.sync[key]!, rpc.sync, args);
+    },
+  });
+  const shell: typeof rpc.shell = new Proxy({} as typeof rpc.shell, {
+    get(_target, key: keyof typeof rpc.shell) {
+      return (...args: unknown[]) => Reflect.apply(rpc.shell[key], rpc.shell, args);
+    },
+  });
+  const backend: WorkspaceBackend = {
+    id: "peer",
+    type: "real-sync-fenced-shell",
+    connect: async () => ({
+      runtimeId: "same-runtime",
+      sync: "remote",
+      rpc: { sync, shell },
+      close: async () => {},
+    }),
+  };
+  const owner = new Workspace({ storage: local, backends: [backend] });
+  const start = async (id: string) => {
+    for (let step = 0; ; step++) {
+      expect(step).toBeLessThan(30);
+      try {
+        return await (
+          await owner.runtime.exec(id, { id, backend: "peer", sync: "defer" })
+        ).result();
+      } catch (error) {
+        if (!(error instanceof WorkspaceSyncPendingError)) throw error;
+        if (id === "A" && replaced) return error;
+      }
+    }
