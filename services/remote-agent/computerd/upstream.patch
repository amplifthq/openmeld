+          rmSync(join(directory, "target.sqlite"));
+          afterApplyWrite = true;
+        }
+        source = open("source.sqlite");
+        target = open("target.sqlite");
+        if (complete) break;
+      }
+      expect(injected).toBe(true);
+      expect(sawReceipt).toBe(true);
+      if (fault === "flush") expect(replayedEmptyFlush).toBe(true);
+      expect(target.fs.readFileSync("/work/299", "utf8")).toBe("original-299");
+      if (!afterApplyWrite || fault === "replacement") {
+        expect(readPushCursor(target.db)).toEqual(readFetchCursor(source.db));
+        target.fs.writeFileSync("/work/native-result", "written after import");
+      }
+      for await (const step of pullBlocks(source.db, target.rpc)) if (step.complete) break;
+      expect(source.fs.readFileSync("/work/native-result", "utf8")).toBe("written after import");
+    } finally {
+      source.storage.close();
+      target.storage.close();
+      rmSync(directory, { recursive: true, force: true });
+    }
+  },
+);
+
+it.each(["extra-file", "hardlink", "confirmed-hardlink", "delete-recreate", "rename"])(
+  "does not confirm unrelated native effects: %s",
+  async (kind) => {
+    const open = () => {
+      const storage = new NodeSQLiteStorage({ location: ":memory:" });
+      const db = new Database(storage);
+      initializeSchema(db, Date.now);
+      return { storage, db, fs: new SQLiteWorkspaceProvider(db), rpc: createSyncServer(db) };
+    };
+    const source = open();
+    const target = open();
+    try {
+      source.fs.writeFileSync("/a", "old");
+      for await (const step of pushBlocks(source.db, target.rpc)) if (step.complete) break;
+      if (kind === "extra-file") target.fs.writeFileSync("/local", "native-only");
+      if (kind.includes("hardlink")) {
+        link(target.db, "/a", "/local");
+        if (kind === "confirmed-hardlink") {
+          for await (const step of pullBlocks(source.db, target.rpc)) if (step.complete) break;
+        }
+      }
+      if (kind === "delete-recreate") {
+        target.fs.writeFileSync("/local", "old-native");
+        await new WorkspaceFilesystem(target.db).rm("/local");
+        target.fs.writeFileSync("/local", "native-only");
+      }
+      if (kind === "rename") {
+        target.fs.writeFileSync("/before", "native-only");
+        target.fs.renameSync("/before", "/local");
+      }
+      source.fs.writeFileSync("/a", "updated");
+      let receipts = 0;
+      const push = target.rpc.push.bind(target.rpc);
+      target.rpc.push = async (input) => {
+        const response = await push(input);
+        if (response.importReceipt) receipts++;
+        return response;
+      };
+      for await (const step of pushBlocks(source.db, target.rpc)) if (step.complete) break;
+      expect(receipts).toBe(0);
+      for await (const step of pullBlocks(source.db, target.rpc)) if (step.complete) break;
+      expect(source.fs.readFileSync("/local", "utf8")).toBe(
+        kind.includes("hardlink") ? "updated" : "native-only",
+      );
+      expect(source.fs.readFileSync("/a", "utf8")).toBe("updated");
+      receipts = 0;
+      source.fs.writeFileSync("/next", "new independent file");
+      for await (const step of pushBlocks(source.db, target.rpc)) if (step.complete) break;
+      expect(receipts).toBeGreaterThan(0);
+    } finally {
+      source.storage.close();
+      target.storage.close();
+    }
+  },
+);
