+it("admits new work after peer replacement while preserving lost pull evidence", async () => {
+  const local = new SQLiteTestStorage();
+  const oldStorage = new SQLiteTestStorage();
+  const freshStorage = new SQLiteTestStorage();
+  const old = new Database(oldStorage), fresh = new Database(freshStorage);
+  initializeSchema(old, Date.now);
+  initializeSchema(fresh, Date.now);
+  const oldFiles = new SQLiteWorkspaceProvider(old);
+  for (let i = 0; i < 100; i++) oldFiles.writeFileSync("/old-output", String(i));
+  const starts: string[] = [];
+  const runner = {
+    exec(_source: string, options?: { id?: string }) {
+      const id = options!.id!;
+      starts.push(id);
+      new SQLiteWorkspaceProvider(fresh).writeFileSync("/new-output", "retained");
+      return { id, events: new ReadableStream<ExecEvent>({ start(c) {
+        c.enqueue({ id, seq: 1, name: "exit", code: 17 }); c.close();
+      } }) };
+    },
+    get() { throw Object.assign(new Error("old process is gone"), { code: "ENOENT" }); },
+    kill() {}, dispose() {},
+  };
+  const rpc = createWorkspaceServer(fresh, runner);
+  const backend: WorkspaceBackend = {
+    id: "peer", type: "replacement-peer",
+    connect: async () => ({ runtimeId: "new-runtime", sync: "remote", rpc, close: async () => {} }),
+  };
+  const blocks: SyncBlockTelemetry[] = [];
+  const createOwner = () => new Workspace({
+    storage: local, backends: [backend],
+    syncTelemetry: {
+      block(value) {
+        blocks.push(value);
+        throw new Error("diagnostics unavailable");
+      },
+      operation() {},
+    },
+  });
+  let owner = createOwner();
+  const db = new Database(local);
+  try {
+    await owner.fs.writeFile("/input", "preserved input");
+    await captureSyncTarget(db, createSyncServer(old), "peer");
+    const original = db.all("SELECT generation,target_rev FROM _vfs_sync_operations WHERE direction='pull'")[0];
+    let admissions = 0;
+    let result: unknown;
+    for (let step = 0; step < 30; step++) {
+      try {
+        result = await (await owner.runtime.execWithAdmission("new work", {
+          id: "new-command", backend: "peer", sync: "defer",
+        }, async () => {
