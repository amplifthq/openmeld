+    for (const child of chain.reverse()) {
+      path = path === "/" ? `/${child.name}` : `${path}/${child.name}`;
+      paths.set(child.inode, path);
+    }
+    return path;
+  };
+  for (const row of rows) {
+    if (--budget < 0) return undefined;
+    const path = pathFor(row.inode);
+    const entry = path === undefined ? undefined : input.get(path);
+    if (
+      !entry ||
+      entry.kind === "delete" ||
+      entry.kind !== row.type ||
+      (entry.mode & 0o7777) !== (row.mode & 0o7777) ||
+      entry.mtime !== row.mtime
