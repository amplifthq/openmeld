+import { expect, test } from "vitest";
+import { legacyComputerdInfo } from "../../../test-helpers/computerd-info.js";
+import { readComputerdInfo } from "./computerd-info.js";
+
+test("only a known old information response authorizes legacy execution", async () => {
+  expect(
+    (await readComputerdInfo(async () => Response.json(legacyComputerdInfo))).executionSupervision,
+  ).toEqual({ version: 0 });
+  expect(
+    (
+      await readComputerdInfo(async () =>
+        Response.json({
+          ...legacyComputerdInfo,
+          execution: { supervision: 1, epoch: "native-epoch" },
+        }),
+      )
+    ).executionSupervision,
+  ).toEqual({ version: 1, epoch: "native-epoch" });
+});
+
+test.each([
+  null,
+  {},
+  { ...legacyComputerdInfo, execution: null },
+  { ...legacyComputerdInfo, execution: { supervision: 2, epoch: "native-epoch" } },
+  { ...legacyComputerdInfo, execution: { supervision: 1 } },
+  { ...legacyComputerdInfo, execution: { supervision: 1, epoch: "" } },
+])("rejects unreadable capability evidence without taking the legacy path: %j", async (body) => {
+  await expect(readComputerdInfo(async () => Response.json(body))).rejects.toThrow();
+});
+
+test("preserves transport and decoding failures", async () => {
+  await expect(readComputerdInfo(async () => new Response(null, { status: 503 }))).rejects.toThrow(
+    "HTTP 503",
+  );
+  await expect(readComputerdInfo(async () => new Response("bad-json"))).rejects.toThrow();
+  const failure = new Error("connection closed");
+  await expect(
+    readComputerdInfo(async () => {
+      throw failure;
+    }),
+  ).rejects.toBe(failure);
+});
