+            afterApplyWrite = true;
+            injected = true;
+            throw new Error("injected response");
+          }
+          return response;
+        };
+        const acknowledge = peer.acknowledgeImport.bind(peer);
+        peer.acknowledgeImport = async (receipt) => {
