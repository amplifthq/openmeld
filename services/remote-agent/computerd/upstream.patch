+import type { Database } from "../storage.js";
+import { ROOT_INODE } from "../schema/core.js";
+import { canonicalizePath } from "../path.js";
+import type { ChangeEntry } from "./changes.js";
+import { computeManifestHash } from "./manifests.js";
+import type { RetentionScope } from "./retention.js";
+import { compareChangeCursors, currentRev, type ChangeCursor } from "./watermarks.js";
