+import { expect, it } from "vitest";
+import { createSyncServer } from "./server.js";
+import { pushBlocks, pullBlocks } from "./sync-engine.js";
+
+it("finishes a prepared import using maintenance reserve after concurrent content fills the source", async () => {
+  const open = (maxSizeBytes?: number) => {
+    const storage = new NodeSQLiteStorage({ location: ":memory:", maxSizeBytes });
+    const db = new Database(storage);
+    initializeSchema(db, Date.now);
+    return { storage, db, fs: new SQLiteWorkspaceProvider(db), rpc: createSyncServer(db) };
+  };
+  const source = open(8 * 1024 ** 2);
+  const target = open();
+  try {
+    source.fs.writeFileSync("/saved", "keep");
+    let injected = false;
+    const push = target.rpc.push.bind(target.rpc);
+    target.rpc.push = async (input) => {
+      const response = await push(input);
+      if (!response.importReceipt || injected) return response;
+      injected = true;
+      // Real concurrent filesystem writes after the original page is already
+      // planned, pinned and applied. No fake quota or private SQL data fill.
+      source.fs.writeFileSync("/churn", "");
+      const fill = (size: number, limit: number) => {
+        for (let i = 0; i < limit; i++) {
+          const bytes = Buffer.alloc(size);
+          if (size) bytes.writeUInt32LE(i);
+          try { source.fs.writeFileSync(`/fill-${size}-${i}`, bytes); }
+          catch (error) {
+            expect(error).toHaveProperty("code", "ENOSPC");
+            return;
+          }
+        }
+        throw new Error("Real content quota was not reached");
+      };
+      fill(16 * 1024, 1024);
+      fill(0, 10000);
+      for (let i = 0; ; i++) {
+        expect(i).toBeLessThan(1000);
+        try { source.storage.assertContentCapacity(4096); }
+        catch (error) {
+          expect(error).toHaveProperty("code", "ENOSPC");
+          break;
+        }
+        const bytes = Buffer.alloc(32);
+        bytes.writeUInt32LE(i);
+        source.fs.writeFileSync("/churn", bytes);
+      }
+      return response;
+    };
+    let complete = false;
+    for await (const step of pushBlocks(source.db, target.rpc)) {
+      if (step.complete) { complete = true; break; }
+    }
+    expect(injected && complete).toBe(true);
+    expect(readFetchCursor(source.db)).toEqual(readPushCursor(target.db));
+    expect(source.db.scalar("SELECT count(*) FROM _vfs_import_receipts")).toBe(0);
+    expect(target.fs.readFileSync("/saved", "utf8")).toBe("keep");
+    expect(source.fs.readFileSync("/saved", "utf8")).toBe("keep");
+    expect(() => source.fs.writeFileSync("/over-capacity", Buffer.alloc(4096)))
+      .toThrow("storage is full");
+  } finally {
+    source.storage.close();
+    target.storage.close();
+  }
+});
+
+it("does not acknowledge an old container cursor if the peer changes after watermarks", async () => {
+  const open = () => {
+    const storage = new NodeSQLiteStorage({ location: ":memory:" });
