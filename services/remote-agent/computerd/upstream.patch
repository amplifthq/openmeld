+import type { ExecEvent } from "@cloudflare/computer-rpc";
+import { createWorkspaceServer } from "@cloudflare/computer-rpc/server";
+import { Database, initializeSchema } from "@cloudflare/dofs";
+import { SQLiteTestStorage } from "@cloudflare/dofs/testing";
+import { expect, test, vi } from "vitest";
+import type { BackendHandle, WorkspaceBackend } from "./backend.js";
+import { WorkspaceSyncPendingError } from "./sync-pending.js";
+import { Workspace } from "./workspace.js";
+
+test.each(["legacy", "v1", "reconnect", "unknown", "missing"] as const)(
+  "selects execution supervision on the final prepared handle: %s",
+  async (mode) => {
+    const local = new SQLiteTestStorage(),
+      remote = new SQLiteTestStorage();
+    const db = new Database(remote);
+    initializeSchema(db, Date.now);
+    const exec = vi.fn((_source: string, options?: { id?: string; supervision?: 1 }) => {
+      const id = options!.id!;
+      return {
+        id,
+        events: new ReadableStream<ExecEvent>({
+          start(c) {
+            c.enqueue({ id, seq: 1, name: "exit", code: 17 });
+            c.close();
+          },
+        }),
+      };
+    });
+    const rpc = createWorkspaceServer(db, { exec, get: exec, kill() {}, dispose() {} });
+    const { epoch } = await rpc.sync.watermarks();
+    let connects = 0;
+    const close = vi.fn(async () => {});
+    const backend: WorkspaceBackend = {
+      id: "native",
+      type: "container",
+      connect: async () => {
+        connects++;
+        const executionSupervision =
+          mode === "legacy"
+            ? { version: 0 as const }
+            : mode === "missing"
+              ? undefined
+              : mode === "unknown"
+                ? ({ version: 2 } as never)
+                : {
+                    version: 1 as const,
+                    epoch: mode === "reconnect" && connects === 1 ? "replaced" : epoch!,
+                  };
+        return {
+          runtimeId: "native-runtime",
+          sync: "remote",
+          rpc,
+          close,
+          executionSupervision,
+        } satisfies BackendHandle;
+      },
+    };
+    const ws = new Workspace({ storage: local, backends: [backend] });
+    const admit = vi.fn(async () => {});
+    const run = async () => {
+      for (let page = 0; page < 20; page++) {
+        try {
+          return await (
+            await ws.runtime.execWithAdmission(
+              "raw source",
+              {
+                id: "one-command",
+                backend: "native",
+                legacySource: "legacy wrapper",
+                sync: "defer",
+              },
+              admit,
+            )
+          ).result();
+        } catch (error) {
+          if (!(error instanceof WorkspaceSyncPendingError)) throw error;
+        }
+      }
+      throw new Error("preparation did not finish");
+    };
+    try {
+      if (mode === "missing" || mode === "unknown") {
+        await expect(run()).rejects.toThrow(/supervision/);
+        expect(admit).not.toHaveBeenCalled();
+        expect(exec).not.toHaveBeenCalled();
+      } else {
+        expect(await run()).toMatchObject({ exitCode: 17 });
+        expect(exec).toHaveBeenCalledOnce();
+        expect(admit).toHaveBeenCalledOnce();
+        expect(exec.mock.calls[0][0]).toBe(mode === "legacy" ? "legacy wrapper" : "raw source");
+        expect(exec.mock.calls[0][1]?.supervision).toBe(mode === "legacy" ? undefined : 1);
+        if (mode === "reconnect") {
+          expect(connects).toBe(2);
+          expect(close).toHaveBeenCalledOnce();
+        }
+      }
+    } finally {
+      await ws.close();
+      local.close();
+      remote.close();
+    }
+  },
+);
