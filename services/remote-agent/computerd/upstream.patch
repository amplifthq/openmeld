+  const original = open();
+  const replacement = open();
+  try {
+    source.fs.writeFileSync("/saved", "original file");
+    for await (const step of pushBlocks(source.db, original.rpc)) if (step.complete) break;
+    original.fs.writeFileSync("/old-result", "previous result");
+    for await (const step of pullBlocks(source.db, original.rpc)) if (step.complete) break;
+    const accepted = readFetchCursor(source.db);
+    replacement.fs.writeFileSync("/new-result", "must survive replacement");
+    for (let i = 0; i <= accepted.rev; i++) replacement.fs.writeFileSync("/churn", `${i}`);
+    source.fs.writeFileSync("/next", "next source file");
+    const before = readPushCursor(replacement.db);
+    const peer = new Proxy(replacement.rpc, {
+      get(target, key) {
+        if (key === "watermarks") return original.rpc.watermarks.bind(original.rpc);
+        const value = Reflect.get(target, key);
+        return typeof value === "function" ? value.bind(target) : value;
+      },
+    });
+    await expect(pushBlocks(source.db, peer)[Symbol.asyncIterator]().next()).rejects.toThrow("ESYNC_STALE_RETENTION");
+    expect(readPushCursor(replacement.db)).toEqual(before);
+    for await (const step of pushBlocks(source.db, replacement.rpc)) if (step.complete) break;
+    for await (const step of pullBlocks(source.db, replacement.rpc)) if (step.complete) break;
+    expect(source.fs.readFileSync("/new-result", "utf8")).toBe("must survive replacement");
+    expect(replacement.fs.readFileSync("/saved", "utf8")).toBe("original file");
+    expect(replacement.fs.readFileSync("/next", "utf8")).toBe("next source file");
+  } finally {
+    source.storage.close();
+    original.storage.close();
+    replacement.storage.close();
+  }
+});
+
