diff --git a/packages/rpc/src/bounded-sync.test.ts b/packages/rpc/src/bounded-sync.test.ts
new file mode 100644
index 0000000..8edf4b1
--- /dev/null
+++ b/packages/rpc/src/bounded-sync.test.ts
@@ -0,0 +1,230 @@
+import {
+  Database,
+  collectContentStep,
+  initializeSchema,
+  SQLiteWorkspaceProvider,
+  readPushCursor,
+  WorkspaceFilesystem,
+} from "@cloudflare/dofs";
+import { NodeSQLiteStorage } from "@cloudflare/dofs/node";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createHash } from "node:crypto";
+import { expect, it } from "vitest";
+import { createSyncServer } from "./server.js";
+import { pushBlocks, pullBlocks, captureSyncTarget } from "./sync-engine.js";
+import { reconcileWatermarks } from "./sync-driver.js";
+
+it("resumes large directory and deletion windows after disk reopen and an applied but lost ACK", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "computer-bounded-"));
+  const open = (name: string) => {
+    const storage = new NodeSQLiteStorage({ location: join(directory, name) });
+    const db = new Database(storage);
+    initializeSchema(db, Date.now);
+    return { storage, db, fs: new SQLiteWorkspaceProvider(db), rpc: createSyncServer(db) };
+  };
+  let source = open("source.sqlite");
+  let target = open("target.sqlite");
+  try {
+    source.fs.mkdirSync("/results", { recursive: true });
+    for (let i = 0; i < 4_000; i++) source.fs.writeFileSync(`/results/file-${i}`, `retained-${i}`);
+    // A directory rename stamps the subtree at one revision, exposing bad
+    // second-column seeks and checkpointing within one revision.
+    source.fs.renameSync("/results", "/renamed");
+    let lost = false;
+    const drive = async (resetRuntime = false) => {
+      let steps = 0;
+      let reset = false;
+      for (;;) {
+        await reconcileWatermarks(source.db, target.rpc);
+        const peer = target.rpc;
+        const original = peer.push.bind(peer);
+        peer.push = async (input) => {
+          const ack = await original(input);
+          if (!lost && input.senderCursor?.path) {
+            lost = true;
+            throw new Error("injected lost ACK");
+          }
+          return ack;
+        };
+        const before = readPushCursor(source.db);
+        let complete = false;
+        let resetNow = false;
+        try {
+          const step = await pushBlocks(source.db, peer)[Symbol.asyncIterator]().next();
+          if (!step.done) {
+            complete = step.value.complete;
+            resetNow = resetRuntime && !reset && !step.value.complete;
+          }
+        } catch (error) {
+          expect(String(error)).toContain("injected lost ACK");
+          expect(readPushCursor(source.db)).toEqual(before);
+        }
+        // Close both real SQLite connections after every preparation,
+        // transfer and cleanup page. No iterator or connection survives.
+        source.storage.close();
+        target.storage.close();
+        if (resetNow) {
+          rmSync(join(directory, "target.sqlite"));
+          reset = true;
+        }
+        source = open("source.sqlite");
+        target = open("target.sqlite");
+        if (complete) break;
+        expect(++steps).toBeLessThan(1500);
+      }
+      expect(steps).toBeGreaterThanOrEqual(1);
+      if (resetRuntime) expect(reset).toBe(true);
+    };
+    await drive();
+    expect(lost).toBe(true);
+    for (let i = 0; i < 4_000; i++)
+      expect(target.fs.readFileSync(`/renamed/file-${i}`, "utf8")).toBe(`retained-${i}`);
+    for (let i = 0; i < 200; i++) source.fs.writeFileSync(`/renamed/new-${i}`, `new-${i}`);
+    await drive(true);
+    // Losing the native database while a newer window is being planned must
+    // restore old, unchanged files too, not only that newer window.
+    expect(target.fs.readFileSync("/renamed/file-3999", "utf8")).toBe("retained-3999");
+    expect(target.fs.readFileSync("/renamed/new-199", "utf8")).toBe("new-199");
+    await new WorkspaceFilesystem(source.db).rm("/renamed", { recursive: true });
+    source.fs.mkdirSync("/renamed", { recursive: true });
+    source.fs.writeFileSync("/renamed/answer.txt", "kept after deletion");
+    await drive();
+    expect(target.fs.readdirSync("/renamed")).toEqual(["answer.txt"]);
+    expect(target.fs.readFileSync("/renamed/answer.txt", "utf8")).toBe("kept after deletion");
+    // Sync readiness hands retired projections to durable maintenance. It
+    // does not wait for every physical cleanup page before reporting ready.
+    for (const db of [source.db, target.db]) {
+      let complete = false;
+      for (let page = 0; page < 500 && !complete; page++) complete = collectContentStep(db).complete;
+      expect(complete).toBe(true);
+    }
+    expect(source.db.scalar<number>("SELECT COUNT(*) FROM _vfs_change_candidates")).toBe(0);
+    // The opposite direction must use the same bounded producer protocol.
+    let pullSteps = 0;
+    for (;;) {
+      const next = await pullBlocks(source.db, target.rpc)[Symbol.asyncIterator]().next();
+      if (next.done || next.value.complete) break;
+      expect(++pullSteps).toBeLessThan(500);
+    }
+    expect(source.fs.readFileSync("/renamed/answer.txt", "utf8")).toBe("kept after deletion");
+  } finally {
+    source.storage.close();
+    target.storage.close();
+    rmSync(directory, { recursive: true, force: true });
+  }
+}, 60_000);
+
+it.each([1, 100])(
+  "replaces an unacknowledged pull target when the peer database changes (new head %s)",
+  async (writes) => {
+    const directory = mkdtempSync(join(tmpdir(), "computer-epoch-"));
+    const open = (name: string) => {
+      const storage = new NodeSQLiteStorage({ location: join(directory, name) });
+      const db = new Database(storage);
+      initializeSchema(db, Date.now);
+      return { storage, db, fs: new SQLiteWorkspaceProvider(db), rpc: createSyncServer(db) };
+    };
+    const local = open("local.sqlite");
+    let remote = open("remote.sqlite");
+    try {
+      for (let i = 0; i < 20; i++) remote.fs.writeFileSync(`/old-${i}`, "old");
+      await captureSyncTarget(local.db, remote.rpc, "default");
+      // No ACK exists yet. Comparing revision counters alone cannot detect this
+      // reset, particularly when the new database has already overtaken the old.
+      remote.storage.close();
+      rmSync(join(directory, "remote.sqlite"));
+      remote = open("remote.sqlite");
+      for (let i = 0; i < writes; i++) remote.fs.writeFileSync(`/new-${i}`, "new");
+      for (let steps = 0; ; steps++) {
+        expect(steps).toBeLessThan(100);
+        const step = await pullBlocks(local.db, remote.rpc)[Symbol.asyncIterator]().next();
+        if (step.done || step.value.complete) break;
+      }
+      expect(local.fs.readFileSync(`/new-${writes - 1}`, "utf8")).toBe("new");
+      expect(local.fs.existsSync("/old-0")).toBe(false);
+    } finally {
+      local.storage.close();
+      remote.storage.close();
