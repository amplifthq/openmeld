@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+import { withDB } from "../fs/with-db.js";
+import { writeFile } from "../fs/writeFile.js";
+import { rm } from "../fs/rm.js";
+import { coalesceChanges } from "./coalesce.js";
+import { currentRev, readPushCursor } from "./watermarks.js";
+import {
+  prepareChangePlan,
+  readChangeCandidates,
+  discardChangePlanStep,
+  PLAN_READ_BUDGET,
+} from "./planning.js";
+
+describe("durable bounded change planning", () => {
+  it("resumes a large live/deletion window without changing the ACK and preserves UTF-16 order", async () => {
+    await withDB(async (db) => {
+      for (let i = 0; i < 2400; i++) await writeFile(db, `/f${i}`, String(i), {}, () => i);
+      for (let i = 0; i < 1200; i++) rm(db, `/f${i}`, {}, () => 1000);
+      await writeFile(db, "/\uE000", "BMP", {}, () => 1);
+      await writeFile(db, "/😀", "astral", {}, () => 1);
+      // Directory rename and recursive delete can give many paths one rev.
+      db.run("UPDATE vfs_nodes SET rev=? WHERE inode<>1", currentRev(db));
+      const request = {
+        generation: "restart",
+        after: { rev: 0, path: null },
+        through: { rev: currentRev(db), path: null },
+      };
+      const expected = [];
+      for await (const e of coalesceChanges(db, request.after, request))
+        expected.push({ path: e.path, rev: e.rev });
+      let steps = 0;
+      let checkpoint: string | undefined;
+      while (true) {
+        // No JS plan object survives this call. Every step reopens durable state.
+        const result = prepareChangePlan(db, request);
+        expect(result.reads).toBeLessThanOrEqual(PLAN_READ_BUDGET);
+        expect(readPushCursor(db)).toEqual({ rev: 0, path: null });
+        expect(result.checkpoint).toMatch(/^[a-f0-9]{64}$/);
+        expect(result.checkpoint).not.toBe(checkpoint);
+        checkpoint = result.checkpoint;
+        steps++;
+        if (result.ready) break;
+        expect(steps).toBeLessThan(100);
+      }
+      expect(steps).toBeGreaterThan(1);
+      expect(prepareChangePlan(db, request).checkpoint).toBe(checkpoint);
+      let after = request.after as { rev: number; path: string | null };
+      const actual = [];
+      while (true) {
+        const page = readChangeCandidates(db, request.generation, after, 17);
+        // Lost ACK must return the same page, not consume the plan.
+        expect(readChangeCandidates(db, request.generation, after, 17)).toEqual(page);
+        if (!page.length) break;
+        actual.push(...page);
+        after = page[page.length - 1]!;
+      }
+      expect(actual).toEqual(expected);
+      let cleanup = 0;
+      while (!discardChangePlanStep(db, request.generation)) cleanup++;
+      expect(cleanup).toBeGreaterThan(0);
+      expect(() => readChangeCandidates(db, request.generation, request.after, 1)).toThrow(
+        "not ready",
+      );
+    });
+  });
+});
diff --git a/packages/dofs/src/sync/planning.ts b/packages/dofs/src/sync/planning.ts
new file mode 100644
index 0000000..c6c7706
--- /dev/null
+++ b/packages/dofs/src/sync/planning.ts
@@ -0,0 +1,324 @@
+import { createHash } from "node:crypto";
+import { ROOT_INODE } from "../schema/core.js";
+import { releasePinsStep } from "./retention.js";
+import type { Database } from "../storage.js";
+import { isIgnored } from "./ignore.js";
+import { drainSyncRemovals } from "./removals.js";
+import { compareChangeCursors, type ChangeCursor } from "./watermarks.js";
+
+// This is a disposable query projection, never a file store or an ACK.
+// One call performs at most this many indexed reads, including hardlink
+// aliases and ancestor walks. The caller must return to its invocation
+// owner between calls; draining prepare() in a loop defeats the CPU bound.
+export const PLAN_READ_BUDGET = 4096;
+const PLAN_CLEANUP_BUDGET = 512;
+export const PLAN_STATEMENTS = [
+  `CREATE TABLE IF NOT EXISTS _vfs_sync_identity (slot TEXT PRIMARY KEY, epoch TEXT NOT NULL)`,
+  `CREATE TABLE IF NOT EXISTS _vfs_retired_change_plans (generation TEXT PRIMARY KEY)`,
+  `CREATE TABLE IF NOT EXISTS _vfs_change_parent_paths (
+    generation TEXT NOT NULL, inode INTEGER NOT NULL, path TEXT NOT NULL,
+    PRIMARY KEY(generation,inode)
+  ) WITHOUT ROWID`,
+  `CREATE TABLE IF NOT EXISTS _vfs_change_plans (
+    generation TEXT PRIMARY KEY, state TEXT NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS _vfs_change_candidates (
+    generation TEXT NOT NULL, path TEXT NOT NULL, rev INTEGER NOT NULL,
+    sort_key BLOB NOT NULL, PRIMARY KEY(generation, path)
+  ) WITHOUT ROWID`,
+  `CREATE INDEX IF NOT EXISTS _vfs_change_candidates_order
+    ON _vfs_change_candidates(generation, rev, sort_key)`,
+];
+
+interface Plan {
+  after: ChangeCursor;
+  through: ChangeCursor;
+  ignore: string[];
+  phase: "live" | "tombs" | "ready";
+  rev: number;
+  inode: number;
+  tombId: number;
+  node?: { inode: number; rev: number };
+  alias?: { parent_inode: number; name: string };
+  walk?: { inode: number; suffix: string };
+}
+
+// SQLite TEXT ordering is UTF-8. Wire cursors use JS UTF-16 ordering.
+// Big-endian UTF-16 preserves that exact order in an indexed BLOB.
+export function cursorSortKey(path: string): Uint8Array {
+  const key = new Uint8Array(path.length * 2);
+  for (let i = 0; i < path.length; i++) {
+    const unit = path.charCodeAt(i);
+    key[i * 2] = unit >>> 8;
+    key[i * 2 + 1] = unit & 255;
+  }
+  return key;
+}
+
+export interface PrepareChangePlanRequest {
+  generation: string;
+  after: ChangeCursor;
+  through: ChangeCursor;
+  ignore?: string[];
+}
+
+export function prepareChangePlan(
+  db: Database,
+  request: PrepareChangePlanRequest,
+): {
+  ready: boolean;
+  reads: number;
+  checkpoint: string;
+} {
+  return db.transactionSync(() => {
+    // Deletion tombstones use the original deletion revision. Finish their
+    // bounded production before planning this fixed revision window.
+    if (!drainSyncRemovals(db)) {
+      // A large detached tree can require many preparation pages before the
+      // plan itself advances. Read its real durable position, not a poll time.
+      const task = db.one<{ inode: number; change_id: number; rev: number }>(
+        `SELECT inode,change_id,rev FROM _vfs_sync_removals
+         ORDER BY priority DESC,inode LIMIT 1`,
+      );
+      const position = task === undefined ? null : {
+        task,
+        child: db.one("SELECT name,child_inode FROM vfs_dirents WHERE parent_inode=? ORDER BY name LIMIT 1", task.inode),
+        chunk: db.scalar<number>("SELECT idx FROM vfs_chunks WHERE inode=? ORDER BY idx LIMIT 1", task.inode),
+      };
+      return { ready: false, reads: 0, checkpoint: createHash("sha256").update(JSON.stringify(position)).digest("hex") };
+    }
+    const retired = db.scalar<string>("SELECT generation FROM _vfs_retired_change_plans LIMIT 1");
+    if (retired !== undefined && discardChangePlanStep(db, retired)) {
+      db.run("DELETE FROM _vfs_retired_change_plans WHERE generation=?", retired);
+    }
+    const stored = db.scalar<string>(
+      "SELECT state FROM _vfs_change_plans WHERE generation = ?",
+      request.generation,
+    );
+    const plan: Plan =
+      stored === undefined
+        ? {
+            after: request.after,
+            through: request.through,
+            ignore: request.ignore ?? [],
+            phase: "live",
+            rev: request.after.path === null ? request.after.rev : request.after.rev - 1,
+            inode: Number.MAX_SAFE_INTEGER,
+            tombId: 0,
+          }
+        : JSON.parse(stored);
+    if (
+      compareChangeCursors(plan.through, request.through) !== 0 ||
+      JSON.stringify(plan.ignore) !== JSON.stringify(request.ignore ?? []) ||
+      compareChangeCursors(request.after, plan.after) < 0
+    ) {
+      throw new Error("sync: planning generation does not match its cursor window");
+    }
+    let reads = 0;
+    const add = (path: string, rev: number) => {
+      if (
+        isIgnored(path, plan.ignore) ||
+        compareChangeCursors({ rev, path }, plan.after) <= 0 ||
+        compareChangeCursors({ rev, path }, plan.through) > 0
+      )
+        return;
+      db.assertContentCapacity(path.length * 6 + 512);
+      db.run(
+        `INSERT INTO _vfs_change_candidates(generation,path,rev,sort_key) VALUES(?,?,?,?)
+        ON CONFLICT(generation,path) DO UPDATE SET rev = MAX(rev, excluded.rev)`,
+        request.generation,
+        path,
+        rev,
+        cursorSortKey(path),
+      );
+    };
+    while (reads < PLAN_READ_BUDGET - 1 && plan.phase !== "ready") {
+      reads++;
+      if (plan.phase === "tombs") {
+        let row = db.one<{ id: number; rev: number; path: string }>(
+          `SELECT id,rev,path FROM vfs_changes WHERE rev=? AND id>? ORDER BY id LIMIT 1`,
+          plan.rev,
+          plan.tombId,
+        );
+        if (!row) {
+          reads++;
+          row = db.one(
+            `SELECT id,rev,path FROM vfs_changes WHERE rev>? AND rev<=? ORDER BY rev,id LIMIT 1`,
+            plan.rev,
+            plan.through.rev,
+          );
+        }
+        if (!row) {
+          plan.phase = "ready";
+          continue;
+        }
+        add(row.path, row.rev);
+        plan.rev = row.rev;
+        plan.tombId = row.id;
+      } else if (!plan.node) {
+        let row = db.one<{ inode: number; rev: number }>(
+          `SELECT inode,rev FROM vfs_nodes WHERE rev=? AND inode>? ORDER BY inode LIMIT 1`,
+          plan.rev,
+          plan.inode,
+        );
+        if (!row) {
+          reads++;
+          row = db.one(
+            `SELECT inode,rev FROM vfs_nodes WHERE rev>? AND rev<=? ORDER BY rev,inode LIMIT 1`,
+            plan.rev,
+            plan.through.rev,
+          );
+        }
+        if (!row) {
+          plan.phase = "tombs";
+          plan.rev = plan.after.path === null ? plan.after.rev : plan.after.rev - 1;
+          plan.tombId = Number.MAX_SAFE_INTEGER;
+          continue;
+        }
+        plan.rev = row.rev;
+        plan.inode = row.inode;
+        if (row.inode === ROOT_INODE) add("/", row.rev);
+        else plan.node = row;
+      } else if (plan.walk) {
+        if (plan.walk.inode === ROOT_INODE) {
+          // A rename during a suspended walk revs the entire subtree. A
+          // changed node belongs to the next window, not this cached walk.
+          const rev = db.scalar<number>(
+            "SELECT rev FROM vfs_nodes WHERE inode = ?",
+            plan.node.inode,
+          );
+          if (rev === plan.node.rev) {
+            const path = `/${plan.walk.suffix}`;
+            add(path, rev);
+            // Directories cannot be hardlinked. A later ancestor rename
+            // revs this node too, so the check above fences cached parents.
+            db.assertContentCapacity(path.length * 2 + 512);
+            db.run(
+              `INSERT INTO _vfs_change_parent_paths(generation,inode,path) VALUES(?,?,?)
+              ON CONFLICT(generation,inode) DO UPDATE SET path=excluded.path`,
+              request.generation,
+              plan.alias!.parent_inode,
+              path.slice(0, -(plan.alias!.name.length + 1)) || "/",
+            );
+          }
+          delete plan.walk;
+        } else {
+          const parent = db.one<{ parent_inode: number; name: string }>(
+            "SELECT parent_inode,name FROM vfs_dirents WHERE child_inode = ? LIMIT 1",
+            plan.walk.inode,
+          );
+          if (!parent) delete plan.walk;
+          else {
+            plan.walk = {
+              inode: parent.parent_inode,
+              suffix: `${parent.name}/${plan.walk.suffix}`,
+            };
+            // Explicit failure leaves the ACK untouched; never silently omit
+            // an unsupported/corrupt path or loop around a directory cycle.
+            if (plan.walk.suffix.length > 65_536)
+              throw new Error("sync: path exceeds planning limit");
+          }
+        }
+      } else {
+        const alias = db.one<{ parent_inode: number; name: string }>(
+          `SELECT parent_inode,name FROM vfs_dirents WHERE child_inode = ?
+           AND (parent_inode,name) > (?,?) ORDER BY parent_inode,name LIMIT 1`,
+          plan.node.inode,
+          plan.alias?.parent_inode ?? 0,
+          plan.alias?.name ?? "",
+        );
+        if (!alias) {
+          delete plan.node;
+          delete plan.alias;
+        } else {
+          plan.alias = alias;
+          reads++;
+          const parent = db.scalar<string>(
+            "SELECT path FROM _vfs_change_parent_paths WHERE generation=? AND inode=?",
+            request.generation,
+            alias.parent_inode,
+          );
+          plan.walk =
+            parent === undefined
+              ? { inode: alias.parent_inode, suffix: alias.name }
+              : {
+                  inode: ROOT_INODE,
+                  suffix: `${parent === "/" ? "" : parent.slice(1) + "/"}${alias.name}`,
+                };
+        }
+      }
+    }
+    db.run(
+      `INSERT INTO _vfs_change_plans(generation,state) VALUES(?,?)
+      ON CONFLICT(generation) DO UPDATE SET state=excluded.state`,
+      request.generation,
+      JSON.stringify(plan),
+    );
+    // Opaque evidence only. Paths and internal traversal state stay with their
+    // owner, while callers can distinguish durable work from another retry.
+    const checkpoint = createHash("sha256").update(JSON.stringify(plan)).digest("hex");
+    return { ready: plan.phase === "ready", reads, checkpoint };
+  });
+}
+
+export function retireChangePlan(db: Database, generation: string): void {
+  db.requestMaintenance();
+  db.run(
+    `INSERT OR IGNORE INTO _vfs_retired_change_plans(generation)
+    VALUES(?)`,
+    generation,
+  );
+}
+
+// Cleanup is a resumable page as well. Never cascade-delete a whole plan
+// in the ACK transaction or during schema initialization.
+export function discardChangePlanStep(db: Database, generation: string, drainRemovals = true): boolean {
+  return db.transactionSync(() => {
+    if (!releasePinsStep(db, generation)) return false;
+    if (drainRemovals && !drainSyncRemovals(db)) return false;
+    db.run(
+      `DELETE FROM _vfs_change_candidates WHERE generation=? AND path IN
+      (SELECT path FROM _vfs_change_candidates WHERE generation=? LIMIT ?)`,
+      generation,
+      generation,
+      PLAN_CLEANUP_BUDGET,
+    );
+    if (db.one("SELECT 1 FROM _vfs_change_candidates WHERE generation=? LIMIT 1", generation))
+      return false;
+    db.run(
+      `DELETE FROM _vfs_change_parent_paths WHERE generation=? AND inode IN
+      (SELECT inode FROM _vfs_change_parent_paths WHERE generation=? LIMIT ?)`,
+      generation,
+      generation,
+      PLAN_CLEANUP_BUDGET,
+    );
+    if (db.one("SELECT 1 FROM _vfs_change_parent_paths WHERE generation=? LIMIT 1", generation))
+      return false;
+    db.run("DELETE FROM _vfs_change_plans WHERE generation=?", generation);
+    return true;
+  });
+}
+
+export function readChangeCandidates(
+  db: Database,
+  generation: string,
+  after: ChangeCursor,
+  limit: number,
+) {
+  const stored = db.scalar<string>(
+    "SELECT state FROM _vfs_change_plans WHERE generation=?",
+    generation,
+  );
+  if (stored === undefined || (JSON.parse(stored) as Plan).phase !== "ready") {
+    throw new Error("sync: change plan is not ready");
+  }
+  const lower = after.path === null ? after.rev + 1 : after.rev;
+  return db.all<{ path: string; rev: number }>(
+    `SELECT path,rev FROM _vfs_change_candidates WHERE generation=?
+     AND (rev,sort_key) > (?,?) ORDER BY rev,sort_key LIMIT ?`,
+    generation,
+    lower,
+    after.path === null ? new Uint8Array() : cursorSortKey(after.path),
+    limit,
+  );
+}
