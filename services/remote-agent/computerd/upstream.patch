+
+it("stages a large file in bounded object pages and resumes after a lost staging ACK", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "computer-chunks-"));
+  const stores = ["source", "target"].map(
+    (name) => new NodeSQLiteStorage({ location: join(directory, name) }),
+  );
+  const [source, target] = stores.map((storage) => {
+    const db = new Database(storage);
+    initializeSchema(db, Date.now);
+    return db;
+  });
+  try {
+    const bytes = new Uint8Array(20 * 1024 * 1024);
+    for (let i = 0; i < 40; i++) bytes.fill(i, i * 512 * 1024, (i + 1) * 512 * 1024);
+    new SQLiteWorkspaceProvider(source!).writeFileSync("/large.bin", bytes);
+    const peer = createSyncServer(target!);
+    const original = peer.pushObjects.bind(peer);
+    let lost = false;
+    let maxChunks = 0;
+    let calls = 0;
+    let stagedCheckpoint: string | undefined;
+    let appliedCheckpoint: string | undefined;
+    peer.pushObjects = async (stream, scope) => {
+      let chunks = 0;
+      const ack = await original(
+        stream.pipeThrough(
+          new TransformStream({
+            transform(value, controller) {
+              chunks++;
+              controller.enqueue(value);
+            },
+          }),
+        ),
+        scope,
+      );
+      maxChunks = Math.max(maxChunks, chunks);
+      calls++;
+      if (!lost) {
+        lost = true;
+        throw new Error("lost staging ACK");
+      }
+      return ack;
+    };
+    for (let steps = 0; ; steps++) {
+      expect(steps).toBeLessThan(30);
+      try {
+        const step = await pushBlocks(source!, peer)[Symbol.asyncIterator]().next();
+        if (step.value?.phase === "transferring") {
+          expect(step.value.checkpoint).toMatch(/^[a-f0-9]{64}$/);
+          if (step.value.entries === 0) {
+            expect(readPushCursor(source!)).toEqual({ rev: 0, path: null });
+            stagedCheckpoint = step.value.checkpoint;
+          } else {
+            expect(stagedCheckpoint).toBeDefined();
+            expect(step.value.checkpoint).not.toBe(stagedCheckpoint);
+            appliedCheckpoint = step.value.checkpoint;
+          }
+        }
+        if (step.done || step.value.complete) break;
+      } catch (error) {
+        expect(String(error)).toContain("lost staging ACK");
+        expect(new SQLiteWorkspaceProvider(target!).existsSync("/large.bin")).toBe(false);
+      }
+    }
+    expect(maxChunks).toBeLessThanOrEqual(16);
+    expect(calls).toBeGreaterThan(1);
+    expect(stagedCheckpoint).toBeDefined();
+    expect(appliedCheckpoint).toBeDefined();
+    const hash = (data: Uint8Array) => createHash("sha256").update(data).digest("hex");
+    expect(
+      hash(new SQLiteWorkspaceProvider(target!).readFileSync("/large.bin") as Uint8Array),
+    ).toBe(hash(bytes));
+  } finally {
+    for (const storage of stores) storage.close();
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
