+import type { SyncProgress } from "@cloudflare/computer-rpc/driver";
+
+/** A successful bounded sync step needs another invocation. For a push
+ * barrier this is issued before dispatch, never for an uncertain spawn. */
+export class WorkspaceSyncPendingError extends Error {
+  readonly code = "ESYNC_PENDING";
+  constructor(readonly progress: SyncProgress) {
+    super(
+      `ESYNC_PENDING: ${progress.direction} ${progress.phase ?? "transferring"}; resume the same operation in a new invocation`,
+    );
+    this.name = "WorkspaceSyncPendingError";
+  }
+}
