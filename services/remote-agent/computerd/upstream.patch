+afterEach(() => vi.restoreAllMocks());
+it("aborts a half-open health transport and releases a healthy response body", async () => {
+  let aborted = false;
+  vi.spyOn(globalThis, "fetch").mockImplementation(async (_url, init) => new Promise((_, reject) => {
+    const signal = init!.signal!;
+    signal.addEventListener("abort", () => { aborted = true; reject(signal.reason); }, { once: true });
+  }));
+  await expect(waitForHealth("http://isolated.invalid/health", 20)).rejects.toThrow("not healthy within 20ms");
+  expect(aborted).toBe(true);
+  let cancelled = false;
+  vi.mocked(fetch).mockResolvedValue(new Response(new ReadableStream({ cancel() { cancelled = true; } })));
+  await waitForHealth("http://isolated.invalid/health", 1000);
+  expect(cancelled).toBe(true);
