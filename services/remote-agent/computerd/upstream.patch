+    if (entry.kind === "symlink" && entry.target !== row.link_target) return undefined;
+    if (entry.kind === "file") {
+      budget -= entry.chunks.length;
+      if (budget < 0 || row.manifest_hash === null) return undefined;
+      const hash = computeManifestHash(entry.chunks);
+      if (
+        hash.length !== row.manifest_hash.length ||
+        hash.some((byte, i) => byte !== row.manifest_hash![i])
+      )
+        return undefined;
+    }
+  }
+  return { rev: end, path: null };
+}
+
+export function sameImportReceipt(a: ImportReceipt, b: ImportReceipt): boolean {
+  return (
+    a.id === b.id &&
+    a.sourceEpoch === b.sourceEpoch &&
+    a.scope.epoch === b.scope.epoch &&
+    a.scope.slot === b.scope.slot &&
+    a.scope.generation === b.scope.generation &&
+    compareChangeCursors(a.sourceCursor, b.sourceCursor) === 0 &&
+    compareChangeCursors(a.after, b.after) === 0 &&
+    compareChangeCursors(a.through, b.through) === 0
+  );
+}
