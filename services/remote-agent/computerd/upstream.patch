diff --git a/packages/rpc/src/retention.test.ts b/packages/rpc/src/retention.test.ts
--- /dev/null
+++ b/packages/rpc/src/retention.test.ts
@@ -0,0 +1,128 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { randomBytes } from "node:crypto";
+import { Database, initializeSchema, SQLiteWorkspaceProvider, collectContentStep, retentionHead, beginRetention, pinBlobs, failOperation, readOperation, readFetchCursor, type RetentionScope } from "@cloudflare/dofs";
+import { NodeSQLiteStorage } from "@cloudflare/dofs/node";
+import { describe, expect, it } from "vitest";
+import { createSyncServer } from "./server.js";
+import { pullBlocks, pushBlocks } from "./sync-engine.js";
+
+function peer(path: string) {
+  const storage = new NodeSQLiteStorage({ location: path });
+  const db = new Database(storage);
+  initializeSchema(db, Date.now);
+  return { storage, db, fs: new SQLiteWorkspaceProvider(db), rpc: createSyncServer(db) };
+}
+function sweep(db: Database) {
+  for (let i = 0; i < 40; i++) if (collectContentStep(db).complete) return;
+  throw new Error("bounded GC did not finish its scan");
+}
+
+describe("content retention across interrupted synchronization", () => {
+  it("rejects a late object response after the same generation is terminal", async () => {
+    const local = peer(":memory:");
+    const remote = peer(":memory:");
+    try {
+      remote.fs.writeFileSync("/late", "must not be applied");
+      let reached!: () => void;
+      let release!: () => void;
+      const entered = new Promise<void>(resolve => { reached = resolve; });
+      const gate = new Promise<void>(resolve => { release = resolve; });
+      const rpc = new Proxy(remote.rpc, { get(target, prop) {
+        if (prop === "hasObjects") return async (...args: Parameters<typeof target.hasObjects>) => {
+          const result = await target.hasObjects(...args);
+          reached(); await gate; return result;
+        };
+        const value = Reflect.get(target, prop);
+        return typeof value === "function" ? value.bind(target) : value;
+      } });
+      const iterator = pullBlocks(local.db, rpc)[Symbol.asyncIterator]();
+      let inflight = iterator.next();
+      while (await Promise.race([entered.then(() => true), inflight.then(() => false)] ) === false) inflight = iterator.next();
+      const operation = readOperation(local.db, "default", "pull")!;
+      const before = readFetchCursor(local.db, "default");
+      failOperation(local.db, "default", "pull", operation.generation, "lost", "injected replacement");
+      release();
+      await expect(inflight).rejects.toThrow("no longer pending");
+      expect(readFetchCursor(local.db, "default")).toEqual(before);
+      expect(local.db.scalar("SELECT count(*) FROM _vfs_blob_pins")).toBe(0);
+      expect(local.db.scalar("SELECT count(*) FROM vfs_blob_bytes")).toBe(0);
+      expect(() => local.fs.readFileSync("/late")).toThrow();
+    } finally { local.storage.close(); remote.storage.close(); }
+  });
+  it.each(["push", "pull"] as const)("retains >16 objects through %s interruption, restart, GC and lost ACK", async direction => {
+    const dir = mkdtempSync(join(tmpdir(), "computer-retention-"));
+    let local = peer(join(dir, "local.sqlite"));
+    let remote = peer(join(dir, "remote.sqlite"));
+    const bytes = randomBytes(20 * 512 * 1024 + 17);
+    try {
+      const source = direction === "push" ? local : remote;
+      source.fs.writeFileSync("/answer.bin", bytes);
+      const drive = () => (direction === "push" ? pushBlocks : pullBlocks)(local.db, remote.rpc)[Symbol.asyncIterator]();
+      let staged = false;
+      for (let i = 0; i < 30; i++) {
+        const step = await drive().next();
+        sweep(local.db); sweep(remote.db);
+        if (step.value?.phase === "transferring") { staged = true; break; }
+      }
+      expect(staged).toBe(true);
+      local.storage.close(); remote.storage.close();
+      local = peer(join(dir, "local.sqlite")); remote = peer(join(dir, "remote.sqlite"));
+      sweep(local.db); sweep(remote.db);
+      let lost = false;
+      const real = remote.rpc;
+      remote.rpc = new Proxy(real, { get(target, prop) {
+        if (direction === "push" && prop === "push") return async (...args: Parameters<typeof real.push>) => {
+          const receipt = await real.push(...args);
+          if (!lost) { lost = true; throw new Error("lost committed ACK"); }
+          return receipt;
+        };
+        const value = Reflect.get(target, prop);
+        return typeof value === "function" ? value.bind(target) : value;
+      } });
+      let done = false;
+      for (let i = 0; i < 80; i++) {
+        try { const step = await drive().next(); done = step.done || step.value.complete; }
+        catch (error) { if ((error as Error).message !== "lost committed ACK") throw error; }
+        sweep(local.db); sweep(remote.db);
+        if (done) break;
+      }
+      expect(done).toBe(true);
+      const receiver = direction === "push" ? remote : local;
+      expect(Buffer.from(receiver.fs.readFileSync("/answer.bin"))).toEqual(bytes);
+      expect(local.db.scalar("SELECT count(*) FROM _vfs_blob_pins")).toBe(0);
+      expect(remote.db.scalar("SELECT count(*) FROM _vfs_blob_pins")).toBe(0);
+    } finally { local.storage.close(); remote.storage.close(); rmSync(dir, { recursive: true, force: true }); }
+  }, 30_000);
+
+  it("protects observed hashes and rejects a late retired owner without deleting a shared live file", async () => {
+    const dir = mkdtempSync(join(tmpdir(), "computer-retention-fence-"));
+    const p = peer(join(dir, "state.sqlite"));
+    try {
+      p.fs.writeFileSync("/a", "retained bytes");
+      p.fs.linkSync("/a", "/b");
+      const entry = await p.rpc.readEntry("/a");
+      if (entry?.kind !== "file") throw new Error("expected file");
+      const head = retentionHead(p.db, "push");
+      const old: RetentionScope = { epoch: head.epoch, slot: "push", generation: "old" };
+      beginRetention(p.db, old, null);
+      expect(await p.rpc.hasObjects(entry.chunks.map(c => c.hash), old)).toHaveLength(1);
+      p.fs.unlinkSync("/a"); p.fs.unlinkSync("/b");
+      sweep(p.db);
+      expect(p.db.scalar("SELECT count(*) FROM vfs_blob_bytes")).toBe(1);
+      const next = { ...old, generation: "next" };
+      beginRetention(p.db, next, "old");
+      pinBlobs(p.db, "next", entry.chunks.map(c => c.hash));
+      sweep(p.db);
+      await expect(p.rpc.hasObjects(entry.chunks.map(c => c.hash), old)).rejects.toThrow("ESYNC_STALE");
+      expect(() => beginRetention(p.db, old, "old")).toThrow("ESYNC_STALE");
+      expect(p.db.scalar("SELECT count(*) FROM vfs_blob_bytes")).toBe(1);
+      expect(await p.rpc.discardChanges!("next", next)).toBe(true);
+      sweep(p.db);
+      expect(p.db.all("SELECT owner FROM _vfs_blob_pins")).toEqual([]);
+      expect(p.db.all("SELECT inode FROM vfs_chunks")).toEqual([]);
+      expect(p.db.scalar("SELECT count(*) FROM vfs_blob_bytes")).toBe(0);
+    } finally { p.storage.close(); rmSync(dir, { recursive: true, force: true }); }
+  });
+});
