@@ -0,0 +1,106 @@
+import { DurableObject } from "cloudflare:workers";
+import type { ShellRPC } from "@cloudflare/computer-rpc";
+import { reconcileSyncSnapshot } from "@cloudflare/computer-rpc/driver";
+import { createSyncServer } from "@cloudflare/computer-rpc/server";
+import { Database, initializeSchema, retentionHead, readFetchCursor } from "@cloudflare/dofs";
+import { createHash } from "node:crypto";
+import { SqlExecutionRuntimeStore } from "../src/execution-runtime-tracker.js";
+import { Workspace } from "../src/workspace.js";
+
+export interface Env {
+  WORKSPACE: DurableObjectNamespace<ExecutionSyncWorkspace>;
+}
+
+export type Loss = "runtime" | "epoch" | "retired epoch";
+
+// The node suite creates these receipts through real execution and sync.
+// This fixture isolates their error contract across actual Workers RPC.
+export class ExecutionSyncWorkspace extends DurableObject<Env> {
+  #workspace: Workspace | undefined;
+  #nativeCalls = 0;
+
+  async prepare(loss: Loss) {
+    const db = new Database(this.ctx.storage);
+    const forbid = async (): Promise<never> => {
+      this.#nativeCalls++;
+      throw new Error("Execution recovery must not read or restart the process");
+    };
+    const shell: ShellRPC = {
+      exec: forbid,
+      getExec: forbid,
+      killExec: forbid,
+      disposeExec: forbid,
+    };
+    this.#workspace = new Workspace({
+      storage: this.ctx.storage,
+      backends: [
+        {
+          id: "peer",
+          type: "retained-execution-window",
+          connect: async () => ({
+            runtimeId: loss === "runtime" ? "replacement-runtime" : "original-runtime",
+            sync: "remote",
+            rpc: { sync: createSyncServer(db), shell },
+            close: async () => {},
+          }),
+        },
+      ],
+    });
+    const head = await createSyncServer(db).watermarks();
+    const epoch = "original-epoch";
+    reconcileSyncSnapshot(db, { ...head, epoch }, "peer");
+    const store = new SqlExecutionRuntimeStore(db);
+    const key = JSON.stringify(["peer", "original"]);
+    store.beginSync(key, "original-runtime", {
+      backend: "peer",
+      epoch,
+      start: { rev: 0, key: new Uint8Array() },
+    });
+    store.syncTarget(key, "original-runtime", { epoch, rev: head.currentRev + 1 });
+    if (loss === "retired epoch") store.retireSyncEpochs("peer", "replacement-epoch");
+  }
+
+  __getWorkspaceStub() {
+    if (!this.#workspace) throw new Error("Prepare the receipt first");
+    return this.#workspace.stub();
+  }
+
+  nativeCalls() {
+    return this.#nativeCalls;
+  }
+
+  async objectBatchRollback() {
+    const failure = new Error("maintenance observer failed");
+    let armed = false;
+    let writes = 0;
+    const db = new Database(this.ctx.storage, () => {
+      if (armed && ++writes === 2) throw failure;
+    });
+    initializeSchema(db, Date.now);
+    const rpc = createSyncServer(db);
+    const scope = { epoch: retentionHead(db, "push").epoch, slot: "push", generation: "worker-batch" };
+    await rpc.beginRetention!(scope, null);
+    const dirty = db.scalar<number>("SELECT dirty FROM _vfs_gc_state WHERE slot=1")!;
+    let originalError = false;
+    armed = true;
+    try {
+      await rpc.pushObjects(new ReadableStream({ start(controller) {
+        for (const text of ["first", "second"]) {
+          const bytes = new TextEncoder().encode(text);
+          controller.enqueue({ bytes, hash: new Uint8Array(createHash("sha256").update(bytes).digest()) });
+        }
+        controller.close();
+      } }), scope);
+    } catch (error) { originalError = error === failure; }
+    return {
+      originalError, writes,
+      objects: db.scalar<number>("SELECT count(*) FROM vfs_blob_bytes"),
+      pins: db.scalar<number>("SELECT count(*) FROM _vfs_blob_pins"),
+      dirtyDelta: db.scalar<number>("SELECT dirty FROM _vfs_gc_state WHERE slot=1")! - dirty,
+      cursor: readFetchCursor(db),
+      receipts: db.scalar<number>("SELECT count(*) FROM _vfs_import_receipts"),
+    };
+  }
+}
+
+export default { fetch: () => new Response("execution sync tests") };
