+// One receive receipt and one outgoing acknowledgement per backend. These
+// belong to an existing transfer generation; they are not another change log.
+export const IMPORT_RECEIPT_STATEMENT = `CREATE TABLE IF NOT EXISTS _vfs_import_receipts (
+  slot TEXT PRIMARY KEY, generation TEXT NOT NULL, receipt TEXT NOT NULL
+)`;
+
+export interface ImportReceipt {
+  id: string;
+  scope: RetentionScope;
+  sourceEpoch: string;
+  sourceCursor: ChangeCursor;
+  after: ChangeCursor;
+  through: ChangeCursor;
+}
+
+export interface ImportRequest {
+  sourceEpoch: string;
+  // The peer has durably applied this cursor in scope.epoch. This is an
+  // actual acknowledgement, including progress made by ordinary pulls.
+  accepted: ChangeCursor;
+}
+
+export function readImportReceipt(db: Database, slot: string): ImportReceipt | undefined {
+  const raw = db.scalar<string>("SELECT receipt FROM _vfs_import_receipts WHERE slot=?", slot);
+  return raw === undefined ? undefined : JSON.parse(raw);
+}
+
+export function saveImportReceipt(db: Database, slot: string, receipt: ImportReceipt): void {
+  // This bounded control record uses the existing maintenance reserve,
+  // like transfer cursors. Full content capacity must not prevent its ACK.
+  db.run(
+    `INSERT INTO _vfs_import_receipts(slot,generation,receipt) VALUES(?,?,?)
+    ON CONFLICT(slot) DO UPDATE SET generation=excluded.generation,receipt=excluded.receipt`,
+    slot,
+    receipt.scope.generation,
+    JSON.stringify(receipt),
+  );
+}
+
+export function clearImportReceipt(db: Database, slot: string): void {
+  db.run("DELETE FROM _vfs_import_receipts WHERE slot=?", slot);
+}
+
+interface Node {
+  inode: number;
+  type: string;
+  mode: number;
+  mtime: number;
+  manifest_hash: Uint8Array | null;
+  link_target: string | null;
+}
+
+// Prove the complete outbound window, not merely revisions minted by apply.
+// A native alias or a pre-existing unacknowledged file must not disappear
+// behind an import's newer inode revision. Work is bounded even for deep
+// directories, many hardlinks, and large manifests. No bytes are read.
+export function proveImportedWindow(
+  db: Database,
+  after: ChangeCursor,
+  entries: readonly ChangeEntry[],
+): ChangeCursor | undefined {
+  if (!db.inTransaction) throw new Error("Import proof requires the apply transaction");
+  const end = currentRev(db);
+  if (after.path !== null || after.rev >= end || entries.length > 256) return undefined;
+  if (
+    db.one("SELECT 1 FROM _vfs_sync_removals LIMIT 1") ||
+    db.one("SELECT 1 FROM vfs_changes WHERE rev>? AND rev<=? LIMIT 1", after.rev, end)
+  )
+    return undefined;
+  const rows = db.all<Node>(
+    "SELECT inode,type,mode,mtime,manifest_hash,link_target FROM vfs_nodes WHERE rev>? AND rev<=? ORDER BY rev,inode LIMIT ?",
+    after.rev,
+    end,
+    entries.length + 1,
+  );
+  if (rows.length > entries.length) return undefined;
+  const input = new Map<string, ChangeEntry>();
+  let budget = 4096;
+  for (const entry of entries) {
+    const path = canonicalizePath(entry.path).path;
+    if (path !== entry.path || input.has(path)) return undefined;
+    input.set(path, entry);
+  }
+  const paths = new Map<number, string>([[ROOT_INODE, "/"]]);
+  const pathFor = (inode: number): string | undefined => {
+    const chain: { inode: number; name: string }[] = [];
+    while (!paths.has(inode)) {
+      if (--budget < 0) return undefined;
+      const links = db.all<{ parent_inode: number; name: string }>(
+        "SELECT parent_inode,name FROM vfs_dirents WHERE child_inode=? LIMIT 2",
+        inode,
+      );
+      if (links.length !== 1) return undefined;
+      chain.push({ inode, name: links[0]!.name });
+      inode = links[0]!.parent_inode;
+    }
