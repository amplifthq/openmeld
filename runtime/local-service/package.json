{
  "name": "@openmeld/local-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./windows-artifact-script": {
      "types": "./src/windows-artifact-script.ts",
      "import": "./src/windows-artifact-script.ts",
      "default": "./dist/windows-artifact-script.js"
    },
    "./heartbeat-policy": {
      "types": "./src/heartbeat-policy.ts",
      "import": "./src/heartbeat-policy.ts",
      "default": "./dist/heartbeat-policy.js"
    },
    "./catalog-sync-skipped-profiles": {
      "types": "./src/catalog-sync-skipped-profiles.ts",
      "import": "./src/catalog-sync-skipped-profiles.ts",
      "default": "./dist/catalog-sync-skipped-profiles.js"
    },
    "./service-reconcile-decision": {
      "types": "./src/service-reconcile-decision.ts",
      "import": "./src/service-reconcile-decision.ts",
      "default": "./dist/service-reconcile-decision.js"
    },
    "./cli-binary-update-artifact": {
      "types": "./src/cli-binary-update-artifact.ts",
      "import": "./src/cli-binary-update-artifact.ts",
      "default": "./dist/cli-binary-update-artifact.js"
    },
    "./windows-artifact-signature": {
      "types": "./src/windows-artifact-signature.ts",
      "import": "./src/windows-artifact-signature.ts",
      "default": "./dist/windows-artifact-signature.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check --no-errors-on-unmatched ./ && pnpm run typecheck"
  },
  "dependencies": {
    "@openmeld/adapter-antigravity": "workspace:*",
    "@openmeld/adapter-claude-code": "workspace:*",
    "@openmeld/adapter-codex": "workspace:*",
    "@openmeld/adapter-core": "workspace:*",
    "@openmeld/adapter-cursor": "workspace:*",
    "@openmeld/adapter-grok-build": "workspace:*",
    "@openmeld/adapter-openclaw": "workspace:*",
    "@openmeld/adapter-opencode": "workspace:*",
    "@openmeld/local-execution": "workspace:*",
    "@openmeld/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  }
}
