{
  "name": "openmeld-open-connector-stg",
  "main": ".openmeld-working-copy-worker.mjs",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "connectors.staging.openmeld.ai",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v1/*",
      "/mcp*",
      "/oauth/*",
      "/docs",
      "/docs/*",
      "/openapi.json",
      "/health"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmeld-open-connector-db-stg",
      "database_id": "79e940f3-e607-4c3a-bf5a-32bea2794763",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TRANSIT_FILES",
      "bucket_name": "openmeld-open-connector-transit-files-stg"
    }
  ],
  "vars": {
    "OOMOL_CONNECT_ORIGIN": "https://connectors.staging.openmeld.ai",
    "OOMOL_CONNECT_ALLOWED_ACTIONS": "*",
    "OOMOL_CONNECT_BLOCKED_ACTIONS": "github.delete_repository,github.create_release",
    "OOMOL_CONNECT_BLOCKED_PROXIES": "*"
  },
  "secrets": {
    "required": [
      "OOMOL_CONNECT_ADMIN_TOKEN",
      "OOMOL_CONNECT_ENCRYPTION_KEY",
      "OOMOL_CONNECT_GITHUB_APP_ID",
      "OOMOL_CONNECT_GITHUB_APP_PRIVATE_KEY",
      "OOMOL_CONNECT_RUNTIME_TOKEN"
    ]
  }
}
